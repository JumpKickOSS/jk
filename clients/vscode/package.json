{
  "name": "jumpkick",
  "displayName": "JumpKick",
  "description": "JumpKick: the build system and agentic workbench for Java, an alternative to Maven and Gradle. The fastest recompiles and re-tests, plus code intelligence your coding agent can use, with live feedback on every build, test and agent run.",
  "version": "0.10.0",
  "publisher": "jumpkick",
  "icon": "icon.png",
  "homepage": "https://jumpkick.build",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/JumpKickOSS/jk.git",
    "directory": "clients/vscode"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Build Tools",
    "Other"
  ],
  "keywords": [
    "jumpkick",
    "jk",
    "java",
    "kotlin",
    "build",
    "maven",
    "gradle"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "workspaceContains:jk.toml"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In an untrusted workspace JumpKick starts no builds, and jk.path is read from user settings only.",
      "restrictedConfigurations": [
        "jk.path"
      ]
    }
  },
  "extensionDependencies": [
    "redhat.java"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "javaExtensions": [
      "./server/jk-jdtls.jar"
    ],
    "commands": [
      {
        "command": "jk.build",
        "title": "Build",
        "category": "JumpKick"
      },
      {
        "command": "jk.test",
        "title": "Test",
        "category": "JumpKick"
      },
      {
        "command": "jk.lock",
        "title": "Lock",
        "category": "JumpKick"
      },
      {
        "command": "jk.sync",
        "title": "Sync dependencies",
        "category": "JumpKick"
      },
      {
        "command": "jk.cancel",
        "title": "Cancel running build",
        "category": "JumpKick"
      },
      {
        "command": "jk.reconnect",
        "title": "Reconnect to the engine",
        "category": "JumpKick"
      },
      {
        "command": "jk.showOutput",
        "title": "Show output",
        "category": "JumpKick"
      },
      {
        "command": "jk.bspInstall",
        "title": "Install BSP connection (.bsp/jk.json)",
        "category": "JumpKick"
      }
    ],
    "taskDefinitions": [
      {
        "type": "jk",
        "required": [
          "task"
        ],
        "properties": {
          "task": {
            "type": "string",
            "description": "JumpKick verb: lock, sync, build, test, assemble, …"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Extra CLI arguments"
          }
        }
      }
    ],
    "configuration": {
      "title": "JumpKick",
      "properties": {
        "jk.path": {
          "type": "string",
          "default": "jk",
          "description": "Path to the jk executable, absolute or on PATH. Set in user settings only: a workspace cannot choose the program this extension runs.",
          "scope": "machine"
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bundle": "node esbuild.mjs",
    "build": "npm run typecheck && npm run bundle",
    "compile-tests": "tsc -p tsconfig.test.json",
    "test:unit": "npm run compile-tests && node test/run-unit.mjs",
    "test:integration": "npm run bundle && npm run build:jdtls && npm run compile-tests && node out/test/integration/runTest.js",
    "test": "npm run build && npm run test:unit && npm run test:jdtls && npm run test:integration",
    "package": "npm run build && npm run build:jdtls && vsce package --no-dependencies",
    "build:jdtls": "node jdtls/build.mjs",
    "test:jdtls": "node jdtls/build.mjs --test"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "20.19.43",
    "@types/vscode": "1.95.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.1",
    "esbuild": "0.28.2",
    "mocha": "12.0.3",
    "typescript": "6.0.3"
  }
}
