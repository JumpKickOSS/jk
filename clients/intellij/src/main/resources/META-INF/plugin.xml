<idea-plugin>
  <id>cc.jumpkick.idea</id>
  <name>JumpKick</name>
  <vendor url="https://github.com/JumpKickOSS/jk">JumpKick</vendor>
  <description><![CDATA[
    JumpKick for IntelliJ (wire-only): an external-system integration that resolves modules,
    source roots, libraries and SDKs from the engine <code>ide-model</code> through the
    <code>jk</code> CLI — never loading engine jars — and re-syncs when <code>jk.toml</code> or
    <code>jk-lock.toml</code> changes. Build/test/lock actions under Tools → JumpKick.
    Requires <code>jk</code> on PATH (or <code>JK_BIN</code>).
  ]]></description>

  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.lang</depends>
  <depends>com.intellij.modules.java</depends>

  <extensions defaultExtensionNs="com.intellij">
    <notificationGroup id="JumpKick" displayType="BALLOON"/>
    <postStartupActivity implementation="cc.jumpkick.idea.JkProjectOpenActivity"/>
    <externalSystemManager implementation="cc.jumpkick.idea.JkExternalSystemManager"/>
    <projectService serviceImplementation="cc.jumpkick.idea.JkSettings"/>
    <projectService serviceImplementation="cc.jumpkick.idea.JkLocalSettings"/>
    <!-- The resolver only spawns the jk CLI, so it runs inside the IDE process (the platform's
         default is a separate JVM per external system). -->
    <registryKey key="JUMPKICK.system.in.process" defaultValue="true"
                 description="Resolve JumpKick projects inside the IDE process."/>
  </extensions>

  <actions>
    <group id="JumpKick.Menu" text="JumpKick" description="JumpKick build tool" popup="true">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
      <action id="JumpKick.Sync"
              class="cc.jumpkick.idea.JkCliAction$Sync"
              text="Sync project"
              description="Re-resolve modules, roots, libraries and SDKs from the engine ide-model"/>
      <action id="JumpKick.SyncDeps"
              class="cc.jumpkick.idea.JkCliAction$SyncDeps"
              text="Sync dependencies only"
              description="Run jk sync (materialize lock artifacts)"/>
      <action id="JumpKick.BspInstall"
              class="cc.jumpkick.idea.JkCliAction$BspInstall"
              text="Install BSP connection"
              description="Run jk bsp install (writes .bsp/jk.json)"/>
      <action id="JumpKick.Build"
              class="cc.jumpkick.idea.JkCliAction$Build"
              text="Build"
              description="Run jk build"/>
      <action id="JumpKick.Test"
              class="cc.jumpkick.idea.JkCliAction$Test"
              text="Test"
              description="Run jk test"/>
      <action id="JumpKick.Lock"
              class="cc.jumpkick.idea.JkCliAction$Lock"
              text="Lock"
              description="Run jk lock"/>
    </group>
  </actions>
</idea-plugin>
