#!/usr/bin/env bash
# Strip known agent/tool co-author and generator trailers from the commit message.
# Enable: git config core.hooksPath scripts/git-hooks
set -euo pipefail

msg_file="${1:-}"
[[ -n "$msg_file" && -f "$msg_file" ]] || exit 0

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

python3 - "$msg_file" "$tmp" <<'PY'
import re, sys
src, dst = sys.argv[1], sys.argv[2]
text = open(src, encoding="utf-8").read()
# Keep human Co-Authored-By; drop known agent/tool identities only.
agent = re.compile(
    r"(?i)^(Co-Authored-By|Generated-By|Assisted-By):\s*.*"
    r"(\b(claude|anthropic|openai|chatgpt|copilot|cursor|codex|grok|gpt-|xai)\b"
    r"|noreply@anthropic\.com|noreply@openai\.com)"
)
out = [line for line in text.splitlines() if not agent.search(line)]
body = "\n".join(out)
body = re.sub(r"\n{3,}", "\n\n", body).rstrip() + "\n"
open(dst, "w", encoding="utf-8").write(body)
PY

mv "$tmp" "$msg_file"
trap - EXIT
