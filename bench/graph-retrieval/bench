def cards(names: list[str], out_dir: Path) -> None:
    """Each MCP server's tools/list as the model is sent it, every turn: count and tokens of the cards."""
    out_dir.mkdir(parents=True, exist_ok=True)
    tree = tree_of(names[0])
    with (out_dir / "cards.jsonl").open("a") as f:
        for server, (cmd, params) in MCP_SERVERS.items():
            try:
                p = subprocess.Popen(cmd, cwd=tree, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                     stderr=subprocess.DEVNULL, text=True)
            except FileNotFoundError:
                print(f"{server}: not installed")
                continue
            try:
                def ask(i, method, prm):
                    p.stdin.write(json.dumps({"jsonrpc": "2.0", "id": i, "method": method, "params": prm}) + "\n")
                    p.stdin.flush()
                    while True:
                        line = p.stdout.readline()
                        if not line:
                            raise RuntimeError(f"{server} closed before answering {method}")
                        try:
                            msg = json.loads(line)
                        except json.JSONDecodeError:
                            continue  # a log line on stdout
                        if msg.get("id") == i:
                            return msg.get("result") or {}
                ask(1, "initialize", {"protocolVersion": "2024-11-05", "capabilities": {},
                                      "clientInfo": {"name": "graph-retrieval-bench", "version": "1"}})
                p.stdin.write(json.dumps({"jsonrpc": "2.0", "method": "notifications/initialized"}) + "\n")
                tools = ask(2, "tools/list", params).get("tools") or []
            except RuntimeError as failed:
                print(failed)
                continue
            finally:
                p.kill()
            text = json.dumps(tools, separators=(",", ":"))
            row = {"server": server, "tools": len(tools), "tokens": tokens(text),
                   "graph_tools": sorted(t["name"] for t in tools)}
            f.write(json.dumps(row) + "\n")
            print(row)


def _line(loc) -> int | None:
    m = re.match(r"L?(\d+)", str(loc or ""))
    return int(m.group(1)) if m else None


def _entity_key(self, key: tuple):
    e = self.entity("method", key)
    return (e["path"], e["lines"][0], e["lines"][1]) if e else None


def _locator(self):
    spans: dict[str, list[tuple]] = {}
    for key, m in self.methods.items():
        e = self.entity_key(key) if not m["synthetic"] else None
        if e:
            spans.setdefault(e[0], []).append(e)

    def locate(path, line):
        if not path or line is None:
            return None
        for p, items in spans.items():
            if _same(p, path):
                inside = [s for s in items if s[1] <= line <= s[2]]
                if inside:
                    return min(inside, key=lambda s: s[2] - s[1])
        return None
    return locate


Model.entity_key = _entity_key
Model.locator = _locator


def main() -> None:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("command", choices=["setup", "run", "index", "edges", "cards", "render"])
    ap.add_argument("--repo", action="append", help="only this repo (repeatable)")
    ap.add_argument("--arm", action="append", choices=sorted(ARMS), help="only this arm (repeatable)")
    ap.add_argument("--runs", type=int, default=3, help="index runs per tool")
    ap.add_argument("--out", help="results directory (default results/<date>)")
    ns = ap.parse_args()
    all_repos = repos()
    names = ns.repo or list(all_repos)
    out_dir = Path(ns.out) if ns.out else HERE / "results" / dt.date.today().isoformat()
    if ns.command == "setup":
        for n in names:
            setup(n, all_repos[n])
    elif ns.command == "run":
        run(names, ns.arm or list(ARMS), out_dir)
    elif ns.command == "index":
        index(names, out_dir, ns.runs)
    elif ns.command == "edges":
        edges(names, out_dir)
    elif ns.command == "cards":
        cards(names, out_dir)
    else:
        render(out_dir)


if __name__ == "__main__":
    main()
