# --------------------------------------------------------------------------- process tree sampling

def scan_procs() -> dict[int, tuple[int, int]]:
    """pid -> (ppid, rss bytes) for every process, from /proc/<pid>/stat."""
    page = os.sysconf("SC_PAGE_SIZE")
    out = {}
    for entry in os.scandir("/proc"):
        if not entry.name.isdigit():
            continue
        try:
            with open(f"/proc/{entry.name}/stat", encoding="ascii", errors="replace") as fh:
                stat = fh.read()
        except OSError:
            continue
        # comm sits in parentheses and may hold spaces; the fields after it are fixed.
        tail = stat.rsplit(")", 1)[1].split()
        out[int(entry.name)] = (int(tail[1]), int(tail[21]) * page)
    return out


_CMDLINES: dict[int, str] = {}


def cmdline(pid: int) -> str:
    if pid not in _CMDLINES:
        try:
            _CMDLINES[pid] = Path(f"/proc/{pid}/cmdline").read_bytes().replace(b"\0", b" ").decode(errors="replace")
        except OSError:
            _CMDLINES[pid] = ""
    return _CMDLINES[pid]


def engine_pids() -> set[int]:
    """The resident jk engines: the pid files under the state root, checked against /proc."""
    pids = set()
    for pid_file in (benchtools.jk_home() / "state" / "engine").glob("*.pid"):
        try:
            pid = int(pid_file.read_text().strip().split()[0])
        except (OSError, ValueError, IndexError):
            continue
        if Path(f"/proc/{pid}").exists():
            pids.add(pid)
    return pids


def resident_roots(tool: str, procs: dict[int, tuple[int, int]]) -> set[int]:
    """Processes the command does not own but the tool's memory bill includes."""
    if tool == "jk":
        return engine_pids() | {pid for pid in procs if "jk-engine" in cmdline(pid) and "java" in cmdline(pid)[:200]}
    if tool == "gradle":
        # Only daemons of the harness's own Gradle home: another checkout's daemon is not this bill.
        return {pid for pid in procs
                if "org.gradle.launcher.daemon.bootstrap.GradleDaemon" in cmdline(pid) and str(gradle_home()) in cmdline(pid)}
    return set()


def tree_rss(roots: set[int], procs: dict[int, tuple[int, int]]) -> int:
    children: dict[int, list[int]] = {}
    for pid, (ppid, _) in procs.items():
        children.setdefault(ppid, []).append(pid)
    seen, stack = set(), list(roots)
    while stack:
        pid = stack.pop()
        if pid in seen or pid not in procs:
            continue
        seen.add(pid)
        stack.extend(children.get(pid, []))
    return sum(procs[pid][1] for pid in seen)


class Sampler(threading.Thread):
    """Peak summed RSS of the command's tree plus the tool's residents, sampled every INTERVAL_S."""

    def __init__(self, tool: str, root_pid: int):
        super().__init__(daemon=True)
        self.tool, self.root_pid = tool, root_pid
        self.peak = 0
        self.resident_start = 0
        self._stop = threading.Event()

    def run(self) -> None:
        first = True
        while not self._stop.is_set():
            procs = scan_procs()
            residents = resident_roots(self.tool, procs)
            if first:
                self.resident_start = tree_rss(residents, procs)
                first = False
            self.peak = max(self.peak, tree_rss(residents | {self.root_pid}, procs))
            self._stop.wait(INTERVAL_S)

    def stop(self) -> None:
        self._stop.set()
        self.join()


# --------------------------------------------------------------------------- shell plumbing

def sh(cmd: list[str], cwd: Path, log: Path | None = None, check: bool = True) -> subprocess.CompletedProcess:
    full_env = tool_env(cmd)
    res = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, env=full_env)
    if log:
        with open(log, "a", encoding="utf-8") as fh:
            fh.write(f"$ {' '.join(cmd)}\n{res.stdout}{res.stderr}\n[exit {res.returncode}]\n\n")
    if check and res.returncode != 0:
        raise SystemExit(f"{' '.join(cmd)} failed in {cwd} (exit {res.returncode}):\n{res.stdout[-3000:]}{res.stderr[-3000:]}")
    return res


def tool_env(cmd: list[str]) -> dict[str, str]:
    """Gradle keeps the harness's private user home. Maven and Gradle drop the shell vars jk strips."""
    env = dict(os.environ)
    name = Path(cmd[0]).name if cmd else ""
    if name not in ("gradle", "mvn"):
        return env
    for key in benchtools.STRIPPED:
        env.pop(key, None)
    if name == "gradle":
        env["GRADLE_USER_HOME"] = str(gradle_home())
    env.update(JAVA_FOR.get(name, {}))
    return env


def timed(tool: str, cmd: list[str], cwd: Path, log: Path) -> tuple[float, int, int, int]:
    """(wall seconds, exit status, peak tree RSS bytes, resident RSS at start)."""
    with open(log, "a", encoding="utf-8") as fh:
        fh.write(f"$ {' '.join(cmd)}\n")
        fh.flush()
        t0 = time.monotonic()
        proc = subprocess.Popen(cmd, cwd=cwd, stdout=fh, stderr=subprocess.STDOUT, env=tool_env(cmd))
        sampler = Sampler(tool, proc.pid)
        sampler.start()
        rc = proc.wait()
        wall = time.monotonic() - t0
        sampler.stop()
        fh.write(f"[exit {rc}, {wall:.2f} s, peak tree rss {sampler.peak >> 20} MiB]\n\n")
    return wall, rc, sampler.peak, sampler.resident_start


def engine_live_jobs() -> int | None:
    res = subprocess.run([JK, "engine", "status", "--no-ansi"], capture_output=True, text=True)
    m = re.search(r"Live Jobs\W+(\d+)", res.stdout)
    return int(m.group(1)) if m else None


def wait_idle(budget_s: float) -> tuple[int | None, float]:
    """Wait until the shared engine has no live job (another gate may be using it), then report."""
    deadline = time.monotonic() + budget_s
    live = engine_live_jobs()
    while live and time.monotonic() < deadline:
        print(f"  engine has {live} live job(s); waiting for it to idle", file=sys.stderr)
        time.sleep(15)
        live = engine_live_jobs()
    return live, os.getloadavg()[0]


# --------------------------------------------------------------------------- working copies

def clone() -> Path:
    repo = WALL_HOME / "repos" / PROJECT["name"]
    if not (repo / ".git").is_dir():
        repo.parent.mkdir(parents=True, exist_ok=True)
        sh(["git", "clone", "-q", PROJECT["source"], str(repo)], cwd=WALL_HOME)
    head = sh(["git", "rev-parse", "HEAD"], cwd=repo).stdout.strip()
    if head != PROJECT["commit"]:
        sh(["git", "fetch", "-q", "origin"], cwd=repo, check=False)
        sh(["git", "checkout", "-q", PROJECT["commit"]], cwd=repo)
    return repo


def _tools_marker() -> str:
    if PINNED is None:
        raise SystemExit("refusing to run: comparator tools were not resolved")
    return f"{PINNED.maven_version}\n{PINNED.gradle_version}\n{benchtools.host_id()}\n"


def working_copy(tool: str, repo: Path, log: Path) -> Path:
    """The tool's copy of the pinned tree, provisioned once: dependencies fetched, one build green."""
    work = WALL_HOME / "work" / tool
    marker = work / ".wall-tools"
    if (work / ".wall-ready").is_file() and marker.is_file() and marker.read_text(encoding="utf-8") == _tools_marker():
        return work
    shutil.rmtree(work, ignore_errors=True)
    work.parent.mkdir(parents=True, exist_ok=True)
    sh(["git", "clone", "-q", "--shared", str(repo), str(work)], cwd=WALL_HOME)
    sh(["git", "checkout", "-q", PROJECT["commit"]], cwd=work)
    for rel in PROJECT["drop"]:
        (work / rel).unlink()
    if tool == "jk":
        for stray in ("pom.xml", "build.gradle", "settings.gradle", "gradlew", "gradlew.bat", "mvnw", "mvnw.cmd", "gradle"):
            path = work / stray
            shutil.rmtree(path) if path.is_dir() else path.unlink(missing_ok=True)
        for name in ("jk.toml", "jk-lock.toml"):
            shutil.copy(HERE / PROJECT["name"] / name, work / name)
        sh([JK, "build", "--skip-tests", "--no-ansi"], cwd=work, log=log)
    elif tool == "gradle":
        res = sh([GRADLE] + gradle_tasks("build") + GRADLE_ON + [f"-Dwall.build-cache={gradle_cache()}"], cwd=work, log=log, check=False)
        if res.returncode != 0:
            _tool_failed(tool, res)
    else:
        res = sh([MVN, "-q"] + MAVEN_OFF + ["-Dmaven.test.skip", "package"], cwd=work, log=log, check=False)
        if res.returncode != 0:
            _tool_failed(tool, res)
    (work / ".wall-ready").write_text(PROJECT["commit"] + "\n")
    marker.write_text(_tools_marker(), encoding="utf-8")
    return work


def gradle_cache() -> Path:
    path = WALL_HOME / "gradle-build-cache"
    path.mkdir(parents=True, exist_ok=True)
    return path


def gradle_home() -> Path:
    """A Gradle user home of the harness's own, so its daemons are the only ones on the memory bill.

    Dependency and wrapper downloads land here once; ~/.gradle is never touched."""
    path = WALL_HOME / "gradle-home"
    path.mkdir(parents=True, exist_ok=True)
    return path



def gradle_tasks(kind: str) -> list[str]:
    return ["test", "--rerun"] if kind == "test" else ["classes", "jar"]


def _tool_failed(tool: str, res: subprocess.CompletedProcess) -> None:
    blob = (res.stdout or "") + (res.stderr or "")
    if tool == "gradle":
        rejected = benchtools.gradle_incompatibility(blob)
        if rejected:
            raise benchtools.GradleRejected(rejected)
    raise SystemExit(f"{tool} failed (exit {res.returncode}):\n{blob[-3000:]}")


def tool_version(tool: str, work: Path) -> str:
    if tool == "jk":
        return sh([JK, "--version"], cwd=work).stdout.strip()
    if PINNED is None:
        raise SystemExit(f"refusing to run: comparator tools are not resolved, so {tool} has no version")
    if tool == "gradle":
        return f"Gradle {PINNED.gradle_version}"
    if tool == "maven":
        return f"Maven {PINNED.maven_version}"
    return tool


# --------------------------------------------------------------------------- the scenarios

def build_cmd(tool: str, redo: bool = False) -> list[str]:
    if tool == "jk":
        return [JK, "build", "--skip-tests", "--no-ansi"] + (["-r"] if redo else [])
    if tool == "gradle":
        return [GRADLE] + gradle_tasks("build") + GRADLE_ON + [f"-Dwall.build-cache={gradle_cache()}"]
    return [MVN, "-q", "-o"] + MAVEN_OFF + ["-Dmaven.test.skip", "package"]


def test_cmd(tool: str) -> list[str]:
    if tool == "jk":
        return [JK, "test", "-r", "--no-ansi"]
    if tool == "gradle":
        return [GRADLE] + gradle_tasks("test") + GRADLE_ON + [f"-Dwall.build-cache={gradle_cache()}"]
    return [MVN, "-q", "-o"] + MAVEN_OFF + ["test"]


def wipe_outputs(tool: str, work: Path, log: Path, cache_too: bool) -> None:
    """Untimed: the outputs go; with cache_too the tool's output cache for this project goes with them."""
    if tool == "jk":
        sh([JK, "clean", "--no-ansi"], cwd=work, log=log)
    elif tool == "gradle":
        shutil.rmtree(work / "build", ignore_errors=True)
        if cache_too:
            shutil.rmtree(work / ".gradle" / "configuration-cache", ignore_errors=True)
            shutil.rmtree(gradle_cache(), ignore_errors=True)
            gradle_cache()
    else:
        shutil.rmtree(work / "target", ignore_errors=True)


def edit(work: Path, tag: str) -> None:
    path = work / PROJECT["edit"]
    with open(path, "a", encoding="utf-8") as fh:
        fh.write(f"\n{EDIT_MARK} {tag}\n")


def unedit(work: Path) -> None:
    sh(["git", "checkout", "-q", "--", PROJECT["edit"]], cwd=work)


def measure(tool: str, scenario: str, work: Path, runs: int, log: Path) -> dict:
    """One row: `runs` timed runs of the scenario; the wall list, its median and p90, the RSS peak."""
    walls, peaks, residents, failures = [], [], [], 0
    for i in range(1, runs + 1):
        if scenario == "clean":
            wipe_outputs(tool, work, log, cache_too=True)
            cmd = build_cmd(tool, redo=True)
        elif scenario == "rebuild":
            if i == 1:
                timed(tool, build_cmd(tool), work, log)   # prime the cache the row restores from
            wipe_outputs(tool, work, log, cache_too=False)
            cmd = build_cmd(tool)
        elif scenario == "noop":
            if i == 1:
                timed(tool, build_cmd(tool), work, log)   # the build the no-op repeats
            cmd = build_cmd(tool)
        elif scenario == "edit":
            if i == 1:
                timed(tool, build_cmd(tool), work, log)   # the edit lands on a built tree
            edit(work, f"{dt.datetime.now():%Y%m%d%H%M%S}-{i}")
            cmd = build_cmd(tool)
        else:
            cmd = test_cmd(tool)
        wall, rc, peak, resident = timed(tool, cmd, work, log)
        if scenario == "edit":
            unedit(work)
        status = "ok" if rc == 0 else f"FAILED exit {rc}"
        print(f"  {tool:<7}{scenario:<9}run {i}: {wall:7.2f} s  peak tree rss {peak >> 20:5d} MiB  {status}", file=sys.stderr)
        if rc != 0:
            failures += 1
            if tool == "gradle" and log.is_file() and benchtools.gradle_incompatibility(
                    log.read_text(encoding="utf-8", errors="replace")):
                break
            continue
        walls.append(round(wall, 2))
        peaks.append(peak)
        residents.append(resident)
    row = {"tool": tool, "scenario": scenario, "runs": len(walls), "failures": failures,
           "command": " ".join(as_typed(c) for c in cmd), "walls_s": walls}
    if tool == "gradle" and failures and log.is_file():
        rejected = benchtools.gradle_incompatibility(log.read_text(encoding="utf-8", errors="replace"))
        if rejected:
            row["status"] = "incompatible-with-latest-gradle"
            row["error"] = rejected
    if walls:
        ordered = sorted(walls)
        row["median_s"] = round(statistics.median(walls), 2)
        row["p90_s"] = ordered[max(0, -(-9 * len(ordered) // 10) - 1)]
        row["peak_rss_mb"] = max(peaks) >> 20
        row["resident_rss_mb"] = max(residents) >> 20
    return row


def as_typed(part: str) -> str:
    """The command as a reader types it: binaries and the init script by name, not by path."""
    if part == JK:
        return "jk"
    if part and part in (MVN, GRADLE):
        return Path(part).name
    if part.startswith(str(HERE)):
        return "bench/wall/" + part[len(str(HERE)) + 1:]
    if part.startswith("-Dwall.build-cache="):
        return "-Dwall.build-cache=$WALL_HOME/gradle-build-cache"
    return part


# --------------------------------------------------------------------------- host, banking, rendering

def host_line() -> str:
    return benchtools.host_summary()


def jk_commit() -> str:
    res = subprocess.run(["git", "-C", str(JK_TREE), "rev-parse", "--short", "HEAD"], capture_output=True, text=True)
    if res.returncode != 0 or not res.stdout.strip():
        raise SystemExit("refusing to run: cannot read the jk tree commit")
    return res.stdout.strip()


def toml_str(value: str) -> str:
    return '"' + value.replace("\\", "\\\\").replace('"', '\\"') + '"'


def _entry_host(entry: dict) -> str:
    return entry.get("host-id") or benchtools.LEGACY_HOST


def _all_banked() -> list[tuple[str, str, dict]]:
    import tomllib
    if not BASELINE.is_file():
        return []
    data = tomllib.loads(BASELINE.read_text()).get("wall", {})
    return [(tool, scenario, entry) for tool, scenarios in data.items() for scenario, entries in scenarios.items() for entry in entries]


def _emit_number(value) -> str:
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, float):
        return f"{value:.2f}"
    if isinstance(value, str):
        return toml_str(value)
    return str(value)


def _emit_saved(out: list[str], tool: str, scenario: str, entry: dict) -> None:
    out.append("")
    out.append(f"[[wall.{tool}.{scenario}]]")
    for key, value in entry.items():
        out.append(f"{key} = {_emit_number(value)}")


def bank(rows: list[dict], versions: dict[str, str], load: str) -> None:
    """Rewrite this host's [[wall.*]] entries. Rows from another host stay in the file, uncompared."""
    text = BASELINE.read_text() if BASELINE.is_file() else ""
    head = text.split("\n" + WALL_MARK, 1)[0].rstrip("\n") + "\n"
    current = benchtools.host_id()
    kept = [(tool, scenario, entry) for tool, scenario, entry in _all_banked() if _entry_host(entry) != current]
    out = [head, "", WALL_MARK]
    out.append("# one entry per tool and scenario for this host. Other-host entries follow and are not compared.")
    today = dt.date.today().isoformat()
    info = benchtools.host_info()
    for row in rows:
        if "median_s" not in row:
            continue
        out.append("")
        out.append(f"[[wall.{row['tool']}.{row['scenario']}]]")
        out.append(f"median-s = {row['median_s']:.2f}")
        out.append(f"p90-s = {row['p90_s']:.2f}")
        out.append(f"peak-rss-mb = {row['peak_rss_mb']}")
        out.append(f"runs = {row['runs']}")
        out.append(f"date = {toml_str(today)}")
        out.append(f"commit = {toml_str(jk_commit())}")
        out.append(f"host = {toml_str(host_line())}")
        out.append(f"host-id = {toml_str(current)}")
        out.append(f"host-cpu = {toml_str(info['cpu'])}")
        out.append(f"host-logical-cpus = {info['logical_cpus']}")
        out.append(f"host-ram-gib = {info['ram_gib']}")
        out.append(f"host-os = {toml_str(info['os'])}")
        out.append(f"host-kernel = {toml_str(info['kernel'])}")
        out.append(f"host-wsl = {'true' if info['wsl'] else 'false'}")
        out.append(f"project = {toml_str(PROJECT['source'].split('github.com/')[1] + '@' + PROJECT['commit'][:9])}")
        out.append(f"tool-version = {toml_str(row.get('tool_version') or versions[row['tool']])}")
        if PINNED is not None:
            out.append(f"maven-version = {toml_str(PINNED.maven_version)}")
            out.append(f"gradle-version = {toml_str(PINNED.gradle_version)}")
            if PINNED.maven_bin is not None:
                out.append(f"maven-binary = {toml_str(str(PINNED.maven_bin))}")
            if PINNED.gradle_bin is not None:
                out.append(f"gradle-binary = {toml_str(str(PINNED.gradle_bin))}")
            out.append(f"stale-tools = {'true' if PINNED.stale_tools else 'false'}")
            out.append(f"offline-tools = {'true' if PINNED.offline_tools else 'false'}")
        out.append(f"command = {toml_str(row['command'])}")
        out.append(f"load = {toml_str(row.get('load') or load)}")
    if kept:
        out.append("")
        out.append("# Other host entries. Not compared with the rows above.")
        for tool, scenario, entry in kept:
            _emit_saved(out, tool, scenario, entry)
    BASELINE.write_text("\n".join(out) + "\n")
    print(f"banked {sum('median_s' in r for r in rows)} entries into {BASELINE}", file=sys.stderr)


def _table(entries: dict[tuple[str, str], dict]) -> str:
    """Walls, peak memory, and the run line for one host's cells."""
    labels = {"clean": "Clean build", "rebuild": "Warm rebuild", "noop": "No-op", "edit": "One-file edit", "test": "Test run"}
    names = {"jk": "jk", "gradle": "Gradle", "maven": "Maven"}
    lines = ["| Scenario | " + " | ".join(f"{names[t]} median / p90" for t in TOOLS) + " |",
             "|---|" + "---:|" * len(TOOLS)]
    for scenario in SCENARIOS:
        cells = []
        for tool in TOOLS:
            entry = entries.get((tool, scenario))
            cells.append(f"{entry['median-s']:.2f} s / {entry['p90-s']:.2f} s" if entry else "—")
        lines.append(f"| {labels[scenario]} | " + " | ".join(cells) + " |")
    lines += ["", "| Scenario | " + " | ".join(f"{names[t]} peak RSS" for t in TOOLS) + " |", "|---|" + "---:|" * len(TOOLS)]
    for scenario in SCENARIOS:
        cells = []
        for tool in TOOLS:
            entry = entries.get((tool, scenario))
            cells.append(f"{entry['peak-rss-mb']:,} MiB" if entry else "—")
        lines.append(f"| {labels[scenario]} | " + " | ".join(cells) + " |")
    if entries:
        any_entry = next(iter(entries.values()))
        versions = "; ".join(sorted({e["tool-version"] for e in entries.values()}))
        hid = _entry_host(any_entry)
        lines += ["", f"Measured {any_entry['date']} on {any_entry['host']} (host `{hid}`); project {any_entry['project']}; "
                      f"{versions}; jk tree at {any_entry['commit']}; {any_entry['runs']} timed runs per cell; {any_entry['load']}."]
    return "\n".join(lines)


def render_table() -> str:
    """The markdown the docs carry between the wall-table markers. Only this host's cells are the table."""
    grouped: dict[str, dict[tuple[str, str], dict]] = {}
    for tool, scenario, entry in _all_banked():
        grouped.setdefault(_entry_host(entry), {})[(tool, scenario)] = entry
    if not grouped:
        return "_No banked wall yet: run `bench/wall/measure --bank`._"
    current = benchtools.host_id()
    parts = [_table(grouped[current]) if current in grouped else f"_No wall rows for this host (`{current}`)._"]
    for host, entries in sorted(grouped.items()):
        if host == current:
            continue
        parts.append(f"## Other host `{host}`\n\nThese rows are not compared with this host.\n\n{_table(entries)}")
    return "\n\n".join(parts)


def render_docs() -> None:
    table = render_table()
    for doc in DOCS:
        text = doc.read_text()
        begin, end = "<!-- wall-table:begin -->", "<!-- wall-table:end -->"
        if begin not in text or end not in text:
            print(f"{doc}: no wall-table markers, left alone", file=sys.stderr)
            continue
        pre, rest = text.split(begin, 1)
        _, post = rest.split(end, 1)
        doc.write_text(f"{pre}{begin}\n{table}\n{end}{post}")
        print(f"rendered the table into {doc}", file=sys.stderr)
    print(table)


# --------------------------------------------------------------------------- main

def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--tool", action="append", choices=TOOLS, help="measure only this tool (repeatable)")
    ap.add_argument("--scenario", action="append", choices=SCENARIOS, help="measure only this scenario (repeatable)")
    ap.add_argument("--runs", type=int, default=5, help="timed runs per cell (default 5)")
    ap.add_argument("--wait-idle", type=float, default=900, help="seconds to wait for the shared engine to have no live job (default 900)")
    ap.add_argument("--bank", action="store_true", help="rewrite the [[wall.*]] tail of wall-baseline.toml and the docs tables")
    ap.add_argument("--render", action="store_true", help="only render the docs tables from wall-baseline.toml")
    ap.add_argument("--from", dest="from_dirs", action="append", type=Path, default=[],
                    help="an earlier run's results directory whose rows fill the cells this run does not measure (repeatable; later wins)")
    benchtools.add_arguments(ap)
    args = ap.parse_args()
    benchtools.use_flags(args)
    if args.render:
        render_docs()
        return 0

    global PINNED, MVN, GRADLE
    tools = args.tool or list(TOOLS)
    scenarios = args.scenario or list(SCENARIOS)
    if args.bank and (args.tool or args.scenario) and not args.from_dirs:
        raise SystemExit("--bank banks a whole run: drop --tool and --scenario, or name the run to fill from with --from")
    if args.runs == 0:
        tools, scenarios = [], []
    if tools:
        if not Path(JK).is_file():
            raise SystemExit(f"refusing to run: jk binary not found at {JK}")
        PINNED = benchtools.resolve(allow_stale=args.allow_stale_tools, offline=args.offline_tools)
        MVN = str(PINNED.maven_bin)
        GRADLE = str(PINNED.gradle_bin)
    earlier: dict[tuple[str, str], dict] = {}
    skipped_hosts: list[dict] = []
    for from_dir in args.from_dirs:
        for line in (from_dir / "rows.jsonl").read_text().splitlines():
            if not line.strip():
                continue
            row = json.loads(line)
            if "median_s" not in row:
                continue
            if benchtools.row_host(row) != benchtools.host_id():
                skipped_hosts.append(row)
                continue
            earlier[(row["tool"], row["scenario"])] = row
    if skipped_hosts:
        ids = ", ".join(sorted({benchtools.row_host(row) for row in skipped_hosts}))
        print(f"skipped {len(skipped_hosts)} cells from other host(s) {ids}; they do not fill this host's bank", file=sys.stderr)
    out_dir = WALL_HOME / "results" / f"{dt.datetime.now():%Y-%m-%dT%H%M%S}"
    out_dir.mkdir(parents=True)
    log = out_dir / "setup.log"
    repo = clone() if tools or args.from_dirs else None
    blocked: dict[str, Exception] = {}
    if repo is not None:
        for tool in tools:
            if tool == "jk":
                continue
            try:
                home, line = benchtools.java_for_project(repo, tool)
            except benchtools.JdkUnavailable as exc:
                blocked[tool] = exc
                continue
            JAVA_FOR["mvn" if tool == "maven" else "gradle"] = {
                "JAVA_HOME": str(home),
                "PATH": f"{home / 'bin'}{os.pathsep}{os.environ.get('PATH', '')}",
            }
            JAVA_META[tool] = (str(home), line)
    works = {}
    for tool in tools:
        if tool in blocked or repo is None:
            continue
        try:
            works[tool] = working_copy(tool, repo, log)
        except benchtools.GradleRejected as exc:
            blocked[tool] = exc
    versions = {tool: tool_version(tool, works[tool]) for tool in works}

    live, load1 = wait_idle(args.wait_idle if tools else 0)
    load = f"loadavg {load1:.1f} at start, engine live jobs {live if live is not None else '?'}"
    for row in earlier.values():
        if row["tool"] not in versions:
            recorded = row.get("tool_version")
            work = WALL_HOME / "work" / row["tool"]
            if recorded:
                versions[row["tool"]] = recorded
            elif PINNED is not None and work.is_dir():
                versions[row["tool"]] = tool_version(row["tool"], work)
            else:
                raise SystemExit(f"refusing to use a {row['tool']} row that records no tool version")
    print(f"host: {host_line()}\n{load}", file=sys.stderr)
    rows = []

    def write_row(row: dict) -> None:
        row.update(benchtools.stamp(PINNED))
        if row["tool"] in JAVA_META:
            row["java_home"], row["java_version"] = JAVA_META[row["tool"]]
        rows.append(row)
        with open(out_dir / "rows.jsonl", "a", encoding="utf-8") as fh:
            fh.write(json.dumps(row, sort_keys=True) + "\n")

    for tool in tools:
        if tool in blocked:
            exc = blocked[tool]
            if isinstance(exc, benchtools.GradleRejected):
                status, error = "incompatible-with-latest-gradle", exc.line
            else:
                status, error = str(exc), getattr(exc, "detail", "")
            for scenario in scenarios:
                write_row({
                    "tool": tool, "scenario": scenario, "runs": 0, "failures": 1,
                    "status": status, "error": error, "command": "", "walls_s": [], "load": load,
                    "tool_version": versions.get(tool, tool),
                })
            continue
        for scenario in scenarios:
            row = measure(tool, scenario, works[tool], args.runs, out_dir / f"{tool}-{scenario}.log")
            row["tool_version"] = versions[tool]
            row["load"] = load
            write_row(row)
    load += f", loadavg {os.getloadavg()[0]:.1f} at end"

    print(f"\n{'tool':<8}{'scenario':<9}{'median':>8}{'p90':>8}{'peak rss':>10}  runs", file=sys.stderr)
    for row in rows:
        if "median_s" in row:
            print(f"{row['tool']:<8}{row['scenario']:<9}{row['median_s']:>7.2f}s{row['p90_s']:>7.2f}s{row['peak_rss_mb']:>7,} MiB  {row['runs']}", file=sys.stderr)
        else:
            print(f"{row['tool']:<8}{row['scenario']:<9}   every run failed; see {out_dir}", file=sys.stderr)
    print(f"rows in {out_dir / 'rows.jsonl'}, logs beside it", file=sys.stderr)
    if any(row["failures"] for row in rows):
        print("a run failed; nothing banked", file=sys.stderr)
        return 1
    if args.bank:
        measured = {(row["tool"], row["scenario"]) for row in rows}
        banked_rows = [row for key, row in earlier.items() if key not in measured] + rows
        banked_rows.sort(key=lambda row: (TOOLS.index(row["tool"]), SCENARIOS.index(row["scenario"])))
        bank(banked_rows, versions, load)
        render_docs()
    return 0


if __name__ == "__main__":
    sys.exit(main())
