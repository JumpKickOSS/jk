HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
import benchtools  # noqa: E402

JK_TREE = HERE.parent
BOARD = JK_TREE / "scoreboard.toml"
DIMS = HERE / "scoreboard.d"
HOME = benchtools.scratch("SCOREBOARD_HOME", "scoreboard")
TIERS = ("fast", "night", "release")

KEY = ("dim", "subject", "project", "tool", "kind")
DEFAULT_BAND = {"count": 0.02, "paired-wall": 0.05, "absolute-wall": 0.15}
IMPROVE = {"count": 0.02, "paired-wall": 0.05, "absolute-wall": 0.05}

HEADER = """\
# scoreboard.toml — every banked subject of the jk loop (bench/scoreboard, PRD go-loop.md).
#
# One [[row]] per (dim, subject, project, tool, kind). `value` is lower-is-better in `unit`; `band`
# is how far above it a jk measurement may land before the run fails; `target` is where the subject
# is headed, and `bench/scoreboard --gaps` ranks rows by value / target. `runs`, `date`, `commit`
# and `host-id` say where the value came from. Only rows of the measuring host are compared.
#
# The ratchet rewrites a row when a measurement improves on it and seeds a row it has never seen;
# it never raises a row. Raise one by hand after an intentional change and say why in the commit.
"""


# --------------------------------------------------------------------------- board file

def key(row: dict) -> tuple:
    return tuple(row.get(k, "") for k in KEY) + (row.get("host-id", ""),)


def load_board(path: Path = BOARD) -> list[dict]:
    if not path.is_file():
        return []
    return list(tomllib.loads(path.read_text(encoding="utf-8")).get("row", []))


def _toml_value(v) -> str:
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, int):
        return str(v)
    if isinstance(v, float):
        return repr(round(v, 4))
    s = str(v).replace("\\", "\\\\").replace('"', '\\"')
    return f'"{s}"'


ORDER = KEY + ("value", "unit", "band", "target", "runs", "date", "commit", "host-id")
# Measurement fields that stay in rows.json and never reach scoreboard.toml.
UNBANKED = ("samples", "baseline-samples", "slack", "unstable", "noisy", "value", "unit", "band", "target", "runs")
# Fields of an absolute-wall measurement the ratchet keeps as `latest-<field>` beside the banked best:
# the docs publish what jk does today against what the other tools do today, never a best-ever.
LATEST = ("value", "p90-s", "root-rss", "runs", "date", "commit", "tool-version", "conditions")


def render_board(rows: list[dict]) -> str:
    out = [HEADER]
    for row in sorted(rows, key=key):
        out.append("\n[[row]]")
        for k in ORDER + tuple(sorted(set(row) - set(ORDER))):
            if k in row and row[k] is not None:
                out.append(f"{k} = {_toml_value(row[k])}")
    return "\n".join(out) + "\n"


# --------------------------------------------------------------------------- judging

def judge(board: list[dict], measured: list[dict], host: str, today: str, commit: str):
    """(new board, failures, notes). Pure: the arithmetic --selftest covers."""
    by_key = {key(r): dict(r) for r in board}
    failures, notes = [], []
    for m in measured:
        if m.get("unstable"):
            notes.append(f"unstable  {m['subject']} [{m['tool']}]: runs {m['samples']} disagree beyond the band; not banked")
            continue
        if m.get("noisy"):
            notes.append(f"noisy     {m['subject']} [{m['tool']}]: {m['noisy']}; recorded, not banked or judged")
            continue
        row = {k: m[k] for k in KEY}
        row["host-id"] = host
        k = key(row)
        kind = m["kind"]
        band = m.get("band", DEFAULT_BAND[kind])
        value = m["value"]
        slack = m.get("slack", 0)
        fresh = {**row, "value": value, "unit": m["unit"], "band": band, "target": m.get("target"),
                 "runs": m["runs"], "date": today, "commit": commit,
                 **{x: v for x, v in m.items() if x not in UNBANKED and x not in row}}
        old = by_key.get(k)
        if kind == "paired-wall":
            # The baseline runs beside the candidate, so the row is today's ratio, not a bank to beat.
            by_key[k] = {**fresh, "target": (old or {}).get("target", fresh["target"])}
            line = (f"{m['subject']} [{m['tool']}]: {value:.2f}× [{m['ci-low']:.2f}–{m['ci-high']:.2f}] "
                    f"{m['candidate-ms']} ms vs {m['baseline-ms']} ms ({m['baseline']})")
            if m["tool"] == "jk" and m["ci-low"] > 1 + band:
                failures.append(f"REGRESSED {line}: slower than the baseline beyond the {band:.0%} band")
            else:
                notes.append(f"paired    {line}")
            continue
        if old is None:
            by_key[k] = fresh
            notes.append(f"seeded    {m['subject']} [{m['tool']}] = {fmt(value, m['unit'])}")
            continue
        if m["tool"] != "jk":
            # Another tool's row is a reference, not a ratchet: it records what that tool does today.
            by_key[k] = {**fresh, "band": old.get("band", band), "target": old.get("target", fresh["target"])}
            continue
        banked = old["value"]
        limit = banked * (1 + band) + slack
        if kind == "absolute-wall":
            by_key[k] = {x: v for x, v in by_key[k].items() if not x.startswith("latest-")}
            by_key[k].update({f"latest-{x}": fresh[x] for x in LATEST if x in fresh})
        if value > limit:
            failures.append(f"REGRESSED {m['subject']} [{m['tool']}]: {fmt(value, m['unit'])}, banked "
                            f"{fmt(banked, m['unit'])} (band {band:.0%}); commits since: {old.get('commit', '?')}..HEAD")
        elif value < banked * (1 - IMPROVE[kind]) - slack or (banked > 0 and value == 0):
            by_key[k] = {**fresh, "band": old.get("band", band), "target": old.get("target", fresh["target"])}
            notes.append(f"improved  {m['subject']} [{m['tool']}]: {fmt(banked, m['unit'])} -> {fmt(value, m['unit'])} (banked)")
    return list(by_key.values()), failures, notes


def fmt(value, unit: str) -> str:
    if unit == "bytes":
        for scale, name in ((1 << 20, "MiB"), (1 << 10, "KiB")):
            if value >= scale:
                return f"{value / scale:.2f} {name}"
        return f"{int(value)} B"
    return f"{value:g} {unit}"


def gaps(board: list[dict], host: str) -> list[tuple[float, dict]]:
    """Rows with a target, worst ratio first. A zero target ranks by the raw value."""
    ranked = []
    for r in board:
        if r.get("host-id") != host or r.get("tool") != "jk" or r.get("target") is None:
            continue
        t = r["target"]
        ratio = r["value"] / t if t else (float("inf") if r["value"] else 0.0)
        if ratio > 1:
            ranked.append((ratio, r))
    return sorted(ranked, key=lambda x: (-x[0], -x[1]["value"]))


def selftest() -> int:
    host, today = "h", "2026-10-18"
    base = [{"dim": "d", "subject": "s", "project": "p", "tool": "jk", "kind": "count", "host-id": host,
             "value": 1000, "unit": "bytes", "band": 0.02, "runs": 3, "date": "2026-10-01", "commit": "abc"}]
    m = lambda v, **kw: [{"dim": "d", "subject": "s", "project": "p", "tool": "jk", "kind": "count",
                          "value": v, "unit": "bytes", "runs": 3, **kw}]
    _, f, _ = judge(base, m(1019), host, today, "def")
    assert not f, f
    _, f, _ = judge(base, m(1021), host, today, "def")
    assert f and "abc..HEAD" in f[0], f
    b, f, n = judge(base, m(900), host, today, "def")
    assert not f and b[0]["value"] == 900 and b[0]["commit"] == "def", (b, n)
    b, f, n = judge(base, m(990), host, today, "def")
    assert b[0]["value"] == 1000 and "latest-value" not in b[0], b
    wbase = [{**base[0], "kind": "absolute-wall", "unit": "s", "band": 0.15, "value": 1.0}]
    wm = lambda v: [{**m(v)[0], "kind": "absolute-wall", "unit": "s", "tool-version": "jk 2"}]
    b, f, n = judge(wbase, wm(1.1), host, today, "def")
    assert not f and b[0]["value"] == 1.0 and b[0]["latest-value"] == 1.1 and b[0]["latest-tool-version"] == "jk 2", b
    b, f, n = judge(b, wm(0.5), host, today, "ghi")
    assert b[0]["value"] == 0.5 and not any(x.startswith("latest-") for x in b[0]), b
    b, f, n = judge(base, m(5000, unstable=True, samples=[1, 9000]), host, today, "def")
    assert not f and b[0]["value"] == 1000 and "unstable" in n[0], n
    b, f, n = judge(base, [{**m(7)[0], "subject": "new"}], host, today, "def")
    assert len(b) == 2 and "seeded" in n[0], n
    gbase = [{**base[0], "tool": "gradle"}]
    b, f, n = judge(gbase, [{**m(5000)[0], "tool": "gradle"}], host, today, "def")
    assert not f and b[0]["value"] == 5000, (f, b)
    zero = [{**base[0], "value": 0}]
    _, f, _ = judge(zero, m(1), host, today, "def")
    assert f, "a zero-banked count must fail on any increase"
    _, f, _ = judge(zero, m(4000, slack=4096), host, today, "def")
    assert not f, "slack absorbs small absolute drift"
    assert render_board(load_board_text(render_board(b))) == render_board(b)
    g = gaps([{**base[0], "target": 100}, {**base[0], "subject": "t", "value": 50, "target": 100}], host)
    assert len(g) == 1 and g[0][0] == 10.0, g
    pw = lambda lo, **kw: [{"dim": "d", "subject": "w", "project": "p", "tool": "jk", "kind": "paired-wall",
                            "value": 1.2, "unit": "ratio", "band": 0.1, "runs": 12, "ci-low": lo, "ci-high": 1.4,
                            "candidate-ms": 120, "baseline-ms": 100, "baseline": "jk 0", "samples": [1], **kw}]
    b, f, n = judge(base, pw(1.05), host, today, "def")
    assert not f and "paired" in n[0], (f, n)
    row = next(r for r in b if r["subject"] == "w")
    assert row["ci-low"] == 1.05 and "samples" not in row, row
    _, f, _ = judge(b, pw(1.11), host, today, "ghi")
    assert f and "slower than the baseline" in f[0], f
    b2, f, n = judge(b, pw(2.0, noisy="load 9"), host, today, "ghi")
    assert not f and "noisy" in n[0] and b2 == b, n
    print("selftest ok")
    return 0


def load_board_text(text: str) -> list[dict]:
    return list(tomllib.loads(text).get("row", []))


# --------------------------------------------------------------------------- dimensions

def load_dims() -> dict:
    sys.dont_write_bytecode = True  # no __pycache__ beside the dimensions in the tree
    dims = {}
    for path in sorted(DIMS.glob("[!_]*.py")):
        spec = importlib.util.spec_from_file_location(f"scoreboard_{path.stem}", path)
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        dims[path.stem] = mod
    return dims


def installed_jk() -> str:
    candidate = benchtools.jk_home() / "bin" / "jk"
    return str(candidate) if candidate.is_file() else (shutil.which("jk") or str(candidate))


def jk_binary() -> str:
    """$JK_BIN, else the installed client, else whatever `jk` is on PATH."""
    return os.environ.get("JK_BIN") or installed_jk()


def jk_commit() -> str:
    res = subprocess.run(["git", "rev-parse", "--short=9", "HEAD"], cwd=JK_TREE, capture_output=True, text=True)
    return res.stdout.strip() or "unknown"


class Context:
    """What a dimension gets: run count, scratch home, the jk binary and a subject filter."""

    def __init__(self, tier: str, runs: int, pairs: int, out: Path, subjects: list[str], baseline: str | None):
        self.tier = tier
        self.runs = runs
        self.pairs = pairs
        self.home = HOME
        self.out = out
        self.jk = jk_binary()
        self.baseline = baseline or os.environ.get("SCOREBOARD_BASELINE") or installed_jk()
        self.subjects = subjects
        self.skipped: list[str] = []
        self.tools: list[str] | None = None

    def wants(self, subject: str) -> bool:
        return not self.subjects or any(fnmatch.fnmatch(subject, s) for s in self.subjects)


# --------------------------------------------------------------------------- quiet gate and calibration

# An absolute wall is taken only on a quiet host: 1-minute load, CPU PSI `some` avg60 (%), and no
# live job on the user's engine. Calibration is a fixed javac run before and after the batch.
QUIET = {"load": 1.0, "cpu-psi-avg60": 0.5}
POLL_S = 300
DRIFT = 0.10
CALIBRATION_CLASSES = 150
NIGHT_DEADLINE = dt.time(6, 30)
LOCK = benchtools.bench_home() / "heavy.lock"
QUEUE = HERE / "night-queue"


def user_engine_jobs() -> int:
    """Live jobs on the user's own engine (not a private one); 0 when it is not running."""
    env = {k: v for k, v in os.environ.items() if k != "JK_STATE_DIR"}
    res = subprocess.run([installed_jk(), "engine", "status", "--no-ansi"], capture_output=True, text=True, env=env)
    m = re.search(r"Live Jobs\W+(\d+)", res.stdout)
    return int(m.group(1)) if m else 0


def busy_reason(cond: dict, jobs: int) -> str | None:
    over = [f"{k} {cond[k]:g} > {limit:g}" for k, limit in QUIET.items() if cond.get(k, 0) > limit]
    if jobs:
        over.append(f"{jobs} live job(s) on the user's engine")
    return "; ".join(over) or None


def wait_quiet(deadline: dt.datetime | None) -> str | None:
    """None once the host is quiet; the reason it is busy if the deadline passes first (None = check once)."""
    while True:
        reason = busy_reason(benchtools.conditions(), user_engine_jobs())
        if reason is None:
            return None
        if deadline is None or dt.datetime.now() >= deadline:
            return reason
        print(f"  host busy ({reason}); next look in {POLL_S // 60} min, until {deadline:%H:%M}", flush=True)
        time.sleep(POLL_S)


def _calibration_sources(root: Path) -> list[Path]:
    """A fixed tree: generated classes with generics, records, lambdas and switches, the same every time."""
    src = root / "src" / "cal"
    src.mkdir(parents=True, exist_ok=True)
    files = []
    for i in range(CALIBRATION_CLASSES):
        f = src / f"C{i}.java"
        prev = f"C{i - 1}" if i else "Object"
        f.write_text(
            f"package cal;\nimport java.util.*;\nimport java.util.stream.*;\n"
            f"public final class C{i} {{\n"
            f"  record R(int a, String b, List<{prev}> c) {{}}\n"
            f"  sealed interface S permits A, B {{}}\n  record A(int v) implements S {{}}\n  record B(String v) implements S {{}}\n"
            f"  static int f(S s) {{ return switch (s) {{ case A a -> a.v() * {i}; case B b -> b.v().length(); }}; }}\n"
            f"  static Map<String, List<Integer>> g(List<R> rs) {{\n"
            f"    return rs.stream().collect(Collectors.groupingBy(R::b, TreeMap::new,"
            f" Collectors.mapping(r -> r.a() + f(new A(r.a())), Collectors.toList())));\n  }}\n}}\n",
            encoding="utf-8")
        files.append(f)
    return files


def calibrate(runs: int = 5) -> float:
    """Median seconds of one fixed javac batch: how fast this host is right now."""
    root = HOME / "calibration"
    files = _calibration_sources(root)
    javac = shutil.which("javac") or str(Path(os.environ.get("JAVA_HOME", "")) / "bin" / "javac")
    walls = []
    for _ in range(runs + 1):
        out = root / "out"
        shutil.rmtree(out, ignore_errors=True)
        t0 = time.perf_counter()
        subprocess.run([javac, "-d", str(out), *map(str, files)], check=True, capture_output=True)
        walls.append(time.perf_counter() - t0)
    return round(statistics.median(walls[1:]), 3)


def calibration_row(seconds: float, runs: int) -> dict:
    return {"dim": "calibration", "subject": "javac.fixed-tree", "project": "generated", "tool": "javac",
            "kind": "absolute-wall", "value": seconds, "unit": "s", "runs": runs, "band": DRIFT}


def absolute_batch(name: str, mod, ctx, board: list[dict], host: str, deadline: dt.datetime | None) -> list[dict]:
    """One absolute-wall dimension behind the quiet gate, calibrated before and after.

    A busy host past the deadline yields no rows at all (`skipped: busy`); calibration drift above
    DRIFT, or a host slower than its banked calibration, marks every row `noisy`. The load at the end
    of a batch is the batch's own, so interference is judged by the calibration alone.
    """
    reason = wait_quiet(deadline)
    if reason is not None:
        ctx.skipped.append(f"{name}: skipped: busy ({reason})")
        return []
    before = calibrate()
    rows = mod.measure(ctx)
    after = calibrate()
    cond = benchtools.conditions()
    banked = next((r["value"] for r in board if r.get("dim") == "calibration" and r.get("host-id") == host), None)
    noisy = None
    if abs(after - before) > DRIFT * min(before, after):
        noisy = f"calibration drifted {before:g} s -> {after:g} s"
    elif banked and min(before, after) > banked * (1 + DRIFT):
        noisy = f"host slower than its banked calibration ({min(before, after):g} s vs {banked:g} s)"
    for row in rows:
        row.update({f"{k}-end": v for k, v in cond.items()})
        row["calibration-s"] = f"{before:g}/{after:g}"
        if noisy:
            row["noisy"] = noisy
    return rows + ([] if noisy else [calibration_row(min(before, after), 2)])


# --------------------------------------------------------------------------- the night

def run_queue(out: Path) -> list[str]:
    """bench/night-queue: one shell command per line, run one after another after the measurements."""
    if not QUEUE.is_file():
        return []
    results = []
    for i, line in enumerate(QUEUE.read_text().splitlines()):
        cmd = line.strip()
        if not cmd or cmd.startswith("#"):
            continue
        t0 = time.monotonic()
        with open(out / f"queue-{i}.log", "w") as log:
            rc = subprocess.run(cmd, shell=True, cwd=JK_TREE, stdout=log, stderr=subprocess.STDOUT).returncode
        results.append(f"`{cmd}`: exit {rc} in {(time.monotonic() - t0) / 60:.0f} min (log {out / f'queue-{i}.log'})")
    return results


def morning_report(path: Path, measured: list[dict], failures: list[str], notes: list[str], skipped: list[str],
                   queue: list[str], board: list[dict], host: str) -> None:
    lines = [f"# Scoreboard night {dt.date.today().isoformat()}", "",
             f"jk tree {jk_commit()}; host `{host}`; {len(measured)} rows measured.", ""]
    sections = [("Regressions", failures), ("Banked and recorded", [n for n in notes if not n.startswith(("noisy", "unstable"))]),
                ("Noisy or unstable (not banked)", [n for n in notes if n.startswith(("noisy", "unstable"))]),
                ("Skipped", skipped), ("Queue", queue),
                ("Top gaps", [f"{r:.1f}× {row['subject']} [{row['project']}] {fmt(row['value'], row['unit'])}, target "
                              f"{fmt(row['target'], row['unit'])}" for r, row in gaps(board, host)[:5]])]
    for title, items in sections:
        lines += [f"## {title}", ""] + ([f"- {x}" for x in items] or ["- none"]) + [""]
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("\n".join(lines), encoding="utf-8")


def hold_heavy_lock():
    """The host-wide lock every heavy run takes (`flock` on it from a shell); None when another holds it."""
    LOCK.parent.mkdir(parents=True, exist_ok=True)
    fh = open(LOCK, "w")
    try:
        fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        fh.close()
        return None
    return fh


def render_docs(dims: dict, board: list[dict], host: str) -> None:
    for mod in dims.values():
        if hasattr(mod, "render"):
            mod.render(board, host)


def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("--tier", choices=TIERS, default="fast")
    ap.add_argument("--dim", action="append", default=[], help="only this dimension (repeatable)")
    ap.add_argument("--subject", action="append", default=[], help="only subjects matching this glob (repeatable)")
    ap.add_argument("--runs", type=int, default=5, help="measured runs per row, after one warm-up (default 5)")
    ap.add_argument("--pairs", type=int, default=20, help="interleaved pairs per paired-wall row (default 20)")
    ap.add_argument("--baseline", help="the jk a paired-wall row compares against (default $SCOREBOARD_BASELINE, else the installed jk)")
    ap.add_argument("--no-bank", action="store_true", help="judge only; leave scoreboard.toml as it is")
    ap.add_argument("--gaps", action="store_true", help="rank banked rows by distance to target; measure nothing")
    ap.add_argument("--render", action="store_true", help="render the docs tables from scoreboard.toml; measure nothing")
    ap.add_argument("--deadline", help="night tier: stop waiting for a quiet host at this local HH:MM (default 06:30)")
    ap.add_argument("--tool", action="append", help="only this tool, where a dimension measures several (repeatable)")
    ap.add_argument("--selftest", action="store_true")
    ns = ap.parse_args(argv)
    if ns.selftest:
        return selftest()

    host = benchtools.host_id()
    board = load_board()
    if ns.gaps:
        ranked = gaps(board, host)
        if not ranked:
            print("no banked jk row on this host is over its target")
        for ratio, r in ranked:
            shown = "∞" if ratio == float("inf") else f"{ratio:.1f}×"
            print(f"{shown:>7}  {r['subject']:<40} {r['project']:<18} {fmt(r['value'], r['unit']):>12}  target {fmt(r['target'], r['unit'])}")
        return 0
    dims = load_dims()
    if ns.render:
        render_docs(dims, board, host)
        return 0

    chosen = [d for d in (ns.dim or dims) if d in dims and (ns.dim or ns.tier in dims[d].TIERS)]
    unknown = sorted(set(ns.dim) - set(dims))
    if unknown:
        raise SystemExit(f"unknown dimension(s): {', '.join(unknown)}; known: {', '.join(dims)}")
    night = ns.tier in ("night", "release") and not ns.dim
    lock = None
    if night or any(getattr(dims[d], "KIND", "") == "absolute-wall" for d in chosen):
        lock = hold_heavy_lock()
        if lock is None:
            raise SystemExit(f"another heavy run holds {LOCK}; the scoreboard waits for none")
    deadline = None
    if night:
        hh, mm = map(int, (ns.deadline or NIGHT_DEADLINE.strftime("%H:%M")).split(":"))
        deadline = dt.datetime.combine(dt.date.today(), dt.time(hh, mm))
        if deadline < dt.datetime.now() - dt.timedelta(hours=12):
            deadline += dt.timedelta(days=1)
    stamp = dt.datetime.now().strftime("%Y%m%d-%H%M%S")
    out = HOME / "results" / stamp
    out.mkdir(parents=True, exist_ok=True)
    ctx = Context(ns.tier, ns.runs, ns.pairs, out, ns.subject, ns.baseline)
    ctx.tools = ns.tool
    measured = []
    # Load-proof kinds first, then the absolute walls, each behind the quiet gate.
    for name in sorted(chosen, key=lambda d: getattr(dims[d], "KIND", "") == "absolute-wall"):
        print(f"── {name}", flush=True)
        if getattr(dims[name], "KIND", "") == "absolute-wall":
            measured += absolute_batch(name, dims[name], ctx, board, host, deadline)
        else:
            measured += dims[name].measure(ctx)
    (out / "rows.json").write_text(json.dumps(measured, indent=1) + "\n", encoding="utf-8")
    queue = run_queue(out) if night else []

    new_board, failures, notes = judge(board, measured, host, dt.date.today().isoformat(), jk_commit())
    for row in measured:
        flag = "   unstable" if row.get("unstable") else "   noisy" if row.get("noisy") else ""
        print(f"  {row['subject']:<40} [{row['tool']}] {fmt(row['value'], row['unit']):>12}{flag}")
    for line in notes + failures + ctx.skipped + queue:
        print(line.replace("(banked)", "(--no-bank: not written)") if ns.no_bank else line)
    if not ns.no_bank:
        BOARD.write_text(render_board(new_board), encoding="utf-8")
        if night:
            render_docs(dims, new_board, host)
    if night:
        report = HOME / "night" / f"{dt.date.today().isoformat()}.md"
        morning_report(report, measured, failures, notes, ctx.skipped, queue, new_board, host)
        print(f"morning report: {report}")
    print(f"rows: {out / 'rows.json'}")
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
