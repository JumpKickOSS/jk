#!/usr/bin/env python3
"""A breadth-first agent screen: one run per task per agent by default, each agent on its
prescription, then a verdict per agent against a baseline series on the same tasks.

    bench/agent-loop/screen-ff --series 19 --task petclinic-callers-addpet --task petclinic-rename-addvisit
    bench/agent-loop/screen-ff --series 19 --agent cursor --confirm --task ...
    bench/agent-loop/screen-ff --series 40 --agent codex --arm codex=jk-nograph --runs 3 --task ...

One run per cell is the screen: with the graph, an agent repeats itself closely, and a second run has
not changed a decision. --confirm reruns, once, only the cells that surprised (correctness lost, or
tokens or turns past ±30% of the baseline). --runs N is a deliberate collection (the heavy-tailed
no-graph arm, a new agent): every cell's run k before any cell's run k+1. A rename run also reports
whether its answer carried --expect, so a change no agent saw is never read as a change that did
nothing. Rows go to change-tasks' results; run numbers are series * 100 + k. Resumable: measured cells
are skipped.
"""
from __future__ import annotations

import argparse
import importlib.machinery
import importlib.util
import json
import statistics
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
PRESCRIPTIONS = {"claude-code": "jk", "cursor": "jk-cursorrules", "grok": "jk", "muse": "jk", "agy": "jk-agyrules",
                 "codex": "jk"}
# Tasks whose baseline needs Docker (petclinic's Testcontainers Postgres test); skipped while it is down.
NEEDS_DOCKER = {"petclinic-rename-addvisit"}
# Ratio of the new median to the baseline's past which a measure counts as better or worse, over all
# tasks; and the ratio past which one task's tokens or turns count as a regression on that task.
BETTER, WORSE, REGRESSED = 0.9, 1.1, 1.3


def load(name: str, path: Path):
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def rows() -> list[dict]:
    out = []
    for f in sorted((HERE / "results").glob("*-change-tasks/rows.jsonl")):
        out += [json.loads(line) for line in f.read_text().splitlines() if line.strip()]
    return [r for r in out if "accepted" in r]


def median(rs: list[dict], key: str) -> float | None:
    vals = [r[key] for r in rs if r.get(key) is not None]
    return statistics.median(vals) if vals else None


def verdict(agent: str, arm: str, series: int, baseline: int, tasks: list[str],
            baseline_arm: str | None = None) -> tuple[str, list[str]]:
    """better, worse or same, and one line per task: the new medians against the baseline's, whose
    arm is the agent's prescription unless given."""
    baseline_arm = baseline_arm or arm
    all_rows = rows()
    lines, ratios, lost, regressed = [], [], False, 0
    for task in tasks:
        new = [r for r in all_rows if (r["driver"], r["arm"], r["task"]) == (agent, arm, task)
               and r["run"] // 100 == series]
        old = [r for r in all_rows if (r["driver"], r["arm"], r["task"]) == (agent, baseline_arm, task)
               and r["run"] // 100 == baseline]
        if not new or not old:
            continue
        cells, worst = [], 0.0
        for key in ("tokens", "turns", "wall_s"):
            a, b = median(new, key), median(old, key)
            if a is not None and b:
                ratios.append(a / b)
                cells.append(f"{key} {b:,.0f}→{a:,.0f}")
                if key != "wall_s":
                    worst = max(worst, a / b)
        regressed += worst > REGRESSED
        ok_new, ok_old = sum(r["accepted"] for r in new) / len(new), sum(r["accepted"] for r in old) / len(old)
        lost |= ok_new < ok_old
        lines.append(f"    {task:36} {'  '.join(cells)}  correct {sum(r['accepted'] for r in new)}/{len(new)}")
    if not ratios:
        return "same", lines
    mid = statistics.median(ratios)
    lines.append(f"    median ratio {mid:.2f}, tasks regressed {regressed}")
    if lost or mid > WORSE or regressed >= 2:
        return "worse", lines
    return ("better" if mid < BETTER and regressed == 0 else "same"), lines


def measured(agent: str, arm: str, task: str, run: int) -> dict | None:
    """The cell's row with a verdict, when one was written."""
    hits = [r for r in rows() if (r["driver"], r["arm"], r["task"], r["run"]) == (agent, arm, task, run)]
    return hits[-1] if hits else None


def last_finding(agent: str, arm: str, task: str, run: int) -> str:
    """Why the cell's newest row has no verdict."""
    for f in sorted((HERE / "results").glob("*-change-tasks/rows.jsonl"), reverse=True):
        for line in reversed(f.read_text().splitlines()):
            if line.strip():
                r = json.loads(line)
                if (r.get("driver"), r.get("arm"), r.get("task"), r.get("run")) == (agent, arm, task, run):
                    return str(r.get("finding") or "no finding")[:200]
    return "no row"


def reached(agent: str, arm: str, task: str, run: int, expect: str) -> bool | None:
    """Whether the run's transcript carries the expected text in a tool answer; None when not found."""
    root = Path.home() / ".cache/jk-bench/agent-loop/change-tasks"
    hits = sorted(root.glob(f"*/{agent}/{arm}/{task}.{run}/transcript.jsonl"))
    if not hits:
        return None
    return expect in hits[-1].read_text(errors="replace").replace("\\n", "\n")


def surprising(row: dict, agent: str, arm: str, task: str, baseline: int) -> str | None:
    """Why a cell's run is worth a second look against the baseline's runs of that cell, or None."""
    old = [r for r in rows() if (r["driver"], r["arm"], r["task"]) == (agent, arm, task) and r["run"] // 100 == baseline]
    if not old:
        return None
    if not row.get("accepted") and sum(r["accepted"] for r in old) / len(old) > 0.5:
        return "correctness lost"
    for key in ("tokens", "turns"):
        a, b = row.get(key), median(old, key)
        if a is not None and b and not 0.7 <= a / b <= 1.3:
            return f"{key} {b:,.0f} -> {a:,.0f}"
    return None


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--series", type=int, required=True, help="run numbers series*100 + k")
    ap.add_argument("--baseline", type=int, default=16, help="the series to compare against")
    ap.add_argument("--agent", action="append", choices=sorted(PRESCRIPTIONS))
    ap.add_argument("--task", action="append", required=True, help="cheapest first")
    ap.add_argument("--runs", type=int, default=1, help="runs per cell, breadth-first (a collection)")
    ap.add_argument("--confirm", action="store_true", help="rerun once only the cells that surprised")
    ap.add_argument("--arm", action="append", default=[], metavar="AGENT=ARM",
                    help="run an agent on another arm than its prescription (compared with the prescription)")
    ap.add_argument("--model", action="append", default=[], metavar="AGENT=MODEL",
                    help="run an agent on another model than its driver's default")
    ap.add_argument("--effort", action="append", default=[], metavar="AGENT=EFFORT",
                    help="run an agent at another reasoning effort than its driver's default")
    ap.add_argument("--expect", default="Checked by jk",
                    help="text a rename answer must carry for the run to test the change")
    ns = ap.parse_args()
    ct = load("smoke_test", HERE / "smoke-test").ct
    arms = dict(PRESCRIPTIONS)
    for pair in ns.arm:
        agent, _, arm = pair.partition("=")
        if agent not in arms or arm not in ct.ARMS:
            raise SystemExit(f"screen-ff: no agent or arm in {pair!r}")
        arms[agent] = arm
    active = list(ns.agent or PRESCRIPTIONS)
    models = dict(pair.partition("=")[::2] for pair in ns.model)
    efforts = dict(pair.partition("=")[::2] for pair in ns.effort)

    def cell(agent: str, task: str, run: int) -> dict | None:
        """One run of a cell, unless it is measured already; its row, or None when it was not measured."""
        arm = arms[agent]
        row = measured(agent, arm, task, run)
        if row is not None:
            return row
        sys.argv = ["change-tasks", "--driver", agent, "--arm", arm, "--task", task,
                    "--first-run", str(run), "--runs", "1"]
        if agent in models:
            sys.argv += ["--model", models[agent]]
        if agent in efforts:
            sys.argv += ["--effort", efforts[agent]]
        try:
            ct.main()
        except Exception as e:  # noqa: BLE001 - one broken cell is a line, not the end of the screen
            print(f"   {agent} {task} #{run} raised {e!r}", flush=True)
        row = measured(agent, arm, task, run)
        if row is None:
            why = last_finding(agent, arm, task, run)
            print(f"   {agent} {task} #{run}: not measured: {why}", flush=True)
            if "did not start" in why:
                print(f"== {agent} dropped: its CLI does not start", flush=True)
                active.remove(agent)
            return None
        if "rename" in task and not arm.endswith("nograph"):
            seen = reached(agent, arm, task, run, ns.expect)
            print(f"   {agent} {task} #{run}: change reached the agent: {seen}", flush=True)
            if seen is False:
                raise SystemExit(f"== stop: {task}'s rename answer did not carry {ns.expect!r}; fix that first")
        return row

    first = ns.series * 100
    for k in range(ns.runs):
        print(f"== run {k + 1} of {ns.runs}: {', '.join(active)}", flush=True)
        for task in ns.task:
            if task in NEEDS_DOCKER and subprocess.run(["docker", "info"], capture_output=True).returncode != 0:
                print(f"   {task}: skipped, Docker is down", flush=True)
                continue
            for agent in list(active):
                cell(agent, task, first + k)
    if ns.confirm:
        again = []
        for task in ns.task:
            for agent in active:
                row = measured(agent, arms[agent], task, first)
                why = row and surprising(row, agent, PRESCRIPTIONS[agent], task, ns.baseline)
                if why:
                    again.append((agent, task))
                    print(f"   confirm {agent} {task}: {why}", flush=True)
        for agent, task in again:
            cell(agent, task, first + ns.runs)
    for agent in active:
        v, lines = verdict(agent, arms[agent], ns.series, ns.baseline, ns.task, PRESCRIPTIONS[agent])
        print(f"== {agent}: {v}", flush=True)
        print("\n".join(lines), flush=True)
    print("== screen done", flush=True)
    return 0


if __name__ == "__main__":
    sys.exit(main())
