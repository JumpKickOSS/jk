def install_hooks(kind: str | None, sandbox: Path, run_dir: Path) -> None:
    """The agent package an arm runs with: jk's graph hook (prototype), or graphify's own install."""
    if kind in ("jk", "jk-replace"):
        settings = sandbox / ".claude" / "settings.json"
        settings.parent.mkdir(exist_ok=True)
        mode = "JK_GRAPH_HOOK_MODE=replace " if kind == "jk-replace" else ""
        hook = {"type": "command",
                "command": f"{mode}JK_GRAPH_HOOK_LOG={run_dir / 'hook.jsonl'} {HERE / 'wrappers' / 'jk-graph-hook'}",
                "timeout": 30}
        settings.write_text(json.dumps({"hooks": {"PreToolUse": [
            {"matcher": "Grep|Glob", "hooks": [hook]}, {"matcher": "Read", "hooks": [hook]}]}}, indent=2))
    elif kind == "graphify":
        # graphify's documented project install: its CLAUDE.md block and its PreToolUse hooks. HOME is
        # the sandbox's own, so nothing lands in the real ~/.claude.
        home = run_dir / "graphify-home"
        home.mkdir(exist_ok=True)
        code, out, _ = sh_env(["graphify", "claude", "install"], sandbox, {"HOME": str(home)}, 300)
        (run_dir / "graphify-install.log").write_text(out, encoding="utf-8")
        if code != 0:
            raise RuntimeError(f"graphify claude install failed: {out[-300:]}")


def write_agents_md(sandbox: Path) -> None:
    """jk's AGENTS.md section and nothing else: no agent's files (JK_AGENTS=none), whatever shell
    launched the bench. A sandbox without the section is a broken arm, so it raises."""
    env = {k: v for k, v in os.environ.items() if k != "CLAUDECODE"}
    env["JK_AGENTS"] = "none"
    p = subprocess.run(["jk", "-u", "-x", "agents"], cwd=sandbox, capture_output=True, text=True, env=env,
                       timeout=300)
    agents_md = sandbox / "AGENTS.md"
    if p.returncode != 0 or "<!-- BEGIN:jumpkick -->" not in (agents_md.read_text() if agents_md.exists() else ""):
        raise RuntimeError(f"jk agents wrote no AGENTS.md section (exit {p.returncode}): {(p.stdout + p.stderr)[-300:]}")


def graph_edges(build_output: str) -> int | None:
    """The edge count `jk graph build` reports (`4,812 nodes · 11,903 edges from …`), or None."""
    m = re.search(r"([\d,]+) edges", build_output)
    return int(m.group(1).replace(",", "")) if m else None


def preflight(spec: dict, tool: str, sandbox: Path, server: dict | None, edges: int | None) -> None:
    """Refuse to start the agent unless the sandbox is the arm its row names: jk's AGENTS.md section,
    a graph with edges, the arm's own files, and an MCP tools/list that carries the graph tools the arm
    offers and none of those it hides. A setup that went wrong is then a finding, never a measurement."""
    problems = []
    if tool == "jk":
        agents_md = sandbox / "AGENTS.md"
        if "<!-- BEGIN:jumpkick -->" not in (agents_md.read_text() if agents_md.exists() else ""):
            problems.append("AGENTS.md has no jk section")
        if not (sandbox / "target" / "graph" / "graph.bin").exists():
            problems.append("no graph at target/graph/graph.bin")
        if edges == 0:
            problems.append("the graph has 0 edges")
    for rel, text in spec.get("files", {}).items():
        target = sandbox / rel
        if not target.exists() or target.read_text() != text:
            problems.append(f"arm file {rel} missing or changed")
    if tool == "jk" and server is not None:
        try:
            client = StdioMcp([server["command"], *server["args"]], cwd=sandbox)
            try:
                names = {t.get("name") for t in client.tools()}
            finally:
                client.close()
        except Exception as e:  # noqa: BLE001 - an unreachable server is the finding
            problems.append(f"MCP server did not answer tools/list: {e}")
        else:
            shown = names & set(JK_GRAPH_TOOLS)
            if spec["hide_graph"] and shown:
                problems.append(f"tools/list shows hidden graph tools {sorted(shown)}")
            elif spec.get("extended") and shown != set(JK_GRAPH_TOOLS):
                problems.append(f"tools/list lacks graph tools {sorted(set(JK_GRAPH_TOOLS) - shown)}")
            elif not spec["hide_graph"] and not names & {"usages", *JK_RELEASED_GRAPH_TOOLS}:
                problems.append("tools/list has no usages")
    if problems:
        raise RuntimeError("preflight: " + "; ".join(problems))


def sh_env(cmd: list[str], cwd: Path, env: dict, timeout: int) -> tuple[int, str, float]:
    import os
    start = time.monotonic()
    try:
        p = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, errors="replace", timeout=timeout,
                           env={**os.environ, **env})
        return p.returncode, p.stdout + p.stderr, time.monotonic() - start
    except subprocess.TimeoutExpired:
        return 124, f"timeout after {timeout}s", time.monotonic() - start


def mcp_servers(tool: str, extra: list[str], hide_graph: bool, sandbox: Path,
                extended: bool = False) -> tuple[str, dict]:
    server = "jk" if tool == "jk" else "results"
    cfg = mcp_server_config(tool, sandbox)
    if extended:
        cfg = {"type": "stdio", "command": str(HERE / "wrappers" / "mcp-filter"),
               "args": ["--extended", "--keep", ",".join(JK_LOOP_TOOLS + JK_RELEASED_LOOP_TOOLS + JK_GRAPH_TOOLS),
                        "--", cfg["command"], *cfg["args"]]}
    if hide_graph:
        # One proxy for every driver: the graph tools are gone from tools/list and refused if called.
        cfg = {"type": "stdio", "command": str(HERE / "wrappers" / "mcp-filter"),
               "args": ["--drop", ",".join(JK_GRAPH_TOOLS + JK_RELEASED_GRAPH_TOOLS), "--", cfg["command"], *cfg["args"]]}
    servers = {server: cfg}
    if "graphify" in extra:
        servers["graphify"] = {"type": "stdio", "command": str(GRAPHIFY_MCP),
                               "args": [str(sandbox / "graphify-out" / "graph.json")]}
    return server, servers


def called(entry: dict) -> str:
    """The tool a transcript entry calls; an MCP call made through a meta-tool counts as the tool it names."""
    name = str(entry.get("tool_use") or "")
    if name in ("use_tool", "call_mcp_tool"):
        try:
            args = json.loads(entry.get("input") or "{}")
        except json.JSONDecodeError:
            args = {}
        inner = args.get("tool_name") or args.get("ToolName") or args.get("name") or args.get("tool")
        if inner:
            return str(inner)
    return name


ABS_PATH = re.compile(r'"((?:file://)?/[^"]*)')


def outside(entry: dict, sandbox: Path | None) -> bool:
    """Whether a file tool's call names only paths outside the sandbox (the agent's own home, its MCP
    tool descriptors): the agent's housekeeping, not reading the project's code. A driver may cut a
    call's input short, so paths are read off the text when it is not whole JSON."""
    if sandbox is None:
        return False
    paths = call_paths(entry)
    root = str(sandbox)
    return bool(paths) and not any(p.startswith(root) for p in paths)


def call_paths(entry: dict) -> list[str]:
    """The absolute paths a tool call names, read off its input (cut short by some drivers, so off the
    text when it is not whole JSON)."""
    raw = str(entry.get("input") or "")
    try:
        args = json.loads(raw or "{}")
        paths = [v for v in args.values() if isinstance(v, str) and v.startswith(("/", "~", "file:"))] \
            if isinstance(args, dict) else []
    except json.JSONDecodeError:
        paths = ABS_PATH.findall(raw)
    return [p.removeprefix("file://") for p in paths]


def navigation(summary: list[dict], sandbox: Path | None = None) -> dict:
    """Tool calls by family, from a driver's transcript spine. A file tool aimed only outside the
    sandbox is `outside`, and a read of files the agent itself wrote earlier in the run (its answer file,
    read back) is `own`: neither is graph nor text, so neither moves the graph share."""
    counts = {"graph": 0, "text": 0, "edits": 0, "build": 0, "outside": 0, "own": 0, "other": 0}
    names: dict[str, int] = {}
    written: set[str] = set()
    first = None
    reads = after_graph = 0
    for entry in summary:
        if "tool_use" not in entry:
            continue
        name = called(entry)
        first = first or name
        if name.split("__")[-1] in EDITS:
            written.update(call_paths(entry))
        names[name] = names.get(name, 0) + 1
        short = name.split("__")[-1]
        command = ""
        if short == "Bash":
            try:
                command = str(json.loads(entry.get("input") or "{}").get("command") or "")
            except json.JSONDecodeError:
                command = str(entry.get("input") or "")
        if short in GRAPH or name.startswith("mcp__graphify__") or SHELL_GRAPH.search(command):
            counts["graph"] += 1
        elif SHELL_TEXT.search(command) or (short in NAV_TEXT and not outside(entry, sandbox)
                                            and not (written and set(call_paths(entry) or ["-"]) <= written)):
            counts["text"] += 1
            reads += short in READS or bool(SHELL_READ.search(command))
            after_graph += counts["graph"] > 0
        elif short in NAV_TEXT and outside(entry, sandbox):
            counts["outside"] += 1
        elif short in NAV_TEXT:
            counts["own"] += 1
        elif short in EDITS:
            counts["edits"] += 1
        elif name.startswith(("mcp__jk__", "mcp__results__")) or short in ("build", "run", "diagnostics", "deps", "why",
                                                                            "results", "skill"):
            counts["build"] += 1
        else:
            counts["other"] += 1
    nav = counts["graph"] + counts["text"]
    # Diagnostics for the tools' authors: the first move, text navigation split into searches and file
    # reads, and the text navigation after the first code-tool call (a fallback to grep and reading).
    return {**counts, "graph_share": counts["graph"] / nav if nav else None, "tool_calls": names,
            "first_tool": first, "searches": counts["text"] - reads, "reads": reads,
            "text_after_code_tool": after_graph if counts["graph"] else None}


def code_tool(task: dict, arm: str) -> str | None:
    """The JumpKick code tool that is the right move for the task, when the arm offers it; else None, and
    the cell does not count toward the tool hit rate."""
    spec = ARMS[arm]
    tool = task.get("code_tool") or CODE_TOOL.get(task.get("kind", ""))
    if tool is None or spec["tool"] != "jk" or spec["hide_graph"]:
        return None
    return tool if tool in DEFAULT_CODE_TOOLS or spec.get("extended") else None


def code_tool_calls(summary: list[dict], tool: str) -> int:
    """Calls of one code tool in a transcript spine: over MCP, by the name a released jk gives it, or as
    `jk code <tool>` in a shell."""
    n = 0
    for entry in summary:
        if "tool_use" not in entry:
            continue
        short = called(entry).split("__")[-1]
        command = ""
        if short == "Bash":
            try:
                command = str(json.loads(entry.get("input") or "{}").get("command") or "")
            except (json.JSONDecodeError, AttributeError):
                command = str(entry.get("input") or "")
        shell = SHELL_CODE.match(command)
        n += RELEASED_NAMES.get(short, short) == tool or bool(shell and shell.group(1).replace("-", "_") == tool)
    return n


# Drivers whose transcripts mark a failed tool call: Claude Code's tool_result is_error, codex's failed
# mcp_tool_call item, copilot's unsuccessful tool.execution_complete, agy's tool step in state ERROR.
ERROR_MARKED = {"claude-code", "codex", "copilot", "agy"}


def tool_errors(transcript: Path, driver: str) -> int | None:
    """Tool calls that failed, from the raw transcript; None for a driver whose events do not mark a failure."""
    if driver not in ERROR_MARKED:
        return None
    try:
        lines = transcript.read_text(errors="replace").splitlines()
    except OSError:
        return None
    n = 0
    for line in lines:
        try:
            ev = json.loads(line)
        except json.JSONDecodeError:
            continue
        if not isinstance(ev, dict):
            continue
        message = ev.get("message")
        for block in (message.get("content") or []) if isinstance(message, dict) else []:
            n += isinstance(block, dict) and block.get("type") == "tool_result" and bool(block.get("is_error"))
        item = ev.get("item") if isinstance(ev.get("item"), dict) else {}
        n += (ev.get("type") == "item.completed" and item.get("type") == "mcp_tool_call"
              and (item.get("status") == "failed" or bool(item.get("error"))))
        data = ev.get("data") if isinstance(ev.get("data"), dict) else {}
        n += ev.get("type") == "tool.execution_complete" and data.get("success") is False
        step = ev.get("step_update") if isinstance(ev.get("step_update"), dict) else {}
        n += step.get("step_type") == "tool" and step.get("state") == "ERROR"
    return n


def answer_key(line: str) -> str:
    """`Type.method` or `Type` as the truth names it, from however the agent wrote it."""
    line = re.sub(r"^[-*\d.)\s]+(?=[A-Za-z_$])", "", line.strip()).strip("`'\" ,;")
    line = re.sub(r"\(.*\)$", "", line).replace("$", ".").replace("#", ".")
    parts = [p for p in line.split(".") if p]
    if len(parts) >= 2 and parts[-1] == parts[-2]:
        parts[-1] = "<init>"
    if len(parts) >= 2 and (parts[-1] == "<init>" or parts[-1][:1].islower()):
        return ".".join(parts[-2:])
    return parts[-1] if parts else ""


def grade(task: dict, sandbox: Path) -> dict:
    """Recall and precision of ANSWER.txt against the task's answer."""
    path = sandbox / "ANSWER.txt"
    if not path.exists():
        return {"recall": 0.0, "precision": 0.0, "f1": 0.0, "answered": 0, "missed": task["answer"], "extra": []}
    got = {k for k in (answer_key(line) for line in path.read_text(errors="replace").splitlines()) if k}
    want = set(task["answer"])
    hit = got & want
    recall = len(hit) / len(want)
    precision = len(hit) / len(got) if got else 0.0
    f1 = 2 * recall * precision / (recall + precision) if hit else 0.0
    return {"recall": round(recall, 3), "precision": round(precision, 3), "f1": round(f1, 3), "answered": len(got),
            "missed": sorted(want - got), "extra": sorted(got - want)}


PREPARED = HOME.parent / "prepared"


def jk_version(home: Path | None = None) -> str | None:
    """The engine version a jk home runs (`version` in lib/jk-engine/jk-engine.toml), or None. The build id
    says a file changed; this says which release answered, so an arm that moved shows in its rows."""
    path = (home or benchtools.jk_home()) / "lib" / "jk-engine" / "jk-engine.toml"
    try:
        return str(tomllib.loads(path.read_text()).get("version") or "") or None
    except (OSError, tomllib.TOMLDecodeError):
        return None


def jk_build_id() -> str:
    """The jk this run uses (`$JK_HOME`, else ~/.jk), client and engine, as file stats: a new install
    is a new build, and a side run against a scratch home is its own build."""
    parts = []
    home = benchtools.jk_home()
    for f in [home / "bin/jk", *sorted((home / "lib/jk-engine").glob("*.jar"))]:
        if f.exists():
            st = f.stat()
            parts.append(f"{f.name}:{st.st_size}:{st.st_mtime_ns}")
    return hashlib.sha1("|".join(parts).encode()).hexdigest()[:12]


def corpus_rev(task: dict) -> str:
    """The commit of the corpus tree a task runs on; empty when it is not a repository."""
    return subprocess.run(["git", "-C", str(CORPUS / task["repo"]), "rev-parse", "HEAD"], capture_output=True,
                          text=True).stdout.strip()


def prepare(task: dict, tool: str, question: bool, sandbox: Path) -> dict:
    """The sandbox up to the agent: the repository materialised, its baseline built (and tested), and
    jk's graph built. Identical for every agent, arm and run of a repository on one jk build, so it is
    built once into PREPARED and copied after; a new install, corpus commit or baseline command is a
    new entry, and entries of older builds are deleted. Only a baseline that came out as the task
    expects, with a graph, is kept."""
    cmd = ["jk", "-u", "-x", "-a", "build", "-S"] if question else test_cmd(tool, task=task)
    rev = corpus_rev(task)
    build = jk_build_id()
    # A task that plants files or edits has a sandbox of its own: shared by repository, the first task's
    # sandbox stood in for every later task of that repository, and a planted trap never reached the agent.
    planted = task["name"] if (TASK_FILES / task["name"] / "inject").exists() or task.get("inject") else ""
    key = hashlib.sha1(json.dumps([task["repo"], rev, tool, cmd, build, planted, test_excludes(), anchor_tail()]).encode()).hexdigest()[:16]
    slot = PREPARED / f"{task['repo']}-{key}"
    if (slot / "meta.json").exists():
        sandbox.parent.mkdir(parents=True, exist_ok=True)
        subprocess.run(["cp", "-a", str(slot / "sandbox"), str(sandbox)], check=True)
        return {**json.loads((slot / "meta.json").read_text()), "prepared": "hit"}
    materialise(task, tool, sandbox)
    code, out, warm = sh(cmd, sandbox, 3600)
    meta = {"code": code, "out": out[-300:], "warm": round(warm, 1), "build": build, "gcode": 0, "edges": None}
    if tool == "jk" and (code != 0) == (task.get("baseline") == "red"):
        gcode, gout, _ = sh(["jk", "-u", "-x", "graph", "build"], sandbox, 1800)
        meta.update(gcode=gcode, gout=gout[-300:], edges=graph_edges(gout))
    if (code != 0) == (task.get("baseline") == "red") and meta["gcode"] == 0:
        for old in PREPARED.glob(f"{task['repo']}-*/meta.json"):
            if json.loads(old.read_text()).get("build") != build:
                shutil.rmtree(old.parent, ignore_errors=True)
        tmp = PREPARED / f".{slot.name}.{os.getpid()}"
        tmp.mkdir(parents=True, exist_ok=True)
        subprocess.run(["cp", "-a", str(sandbox), str(tmp / "sandbox")], check=True)
        (tmp / "meta.json").write_text(json.dumps(meta))
        if not slot.exists():
            tmp.rename(slot)
        else:
            shutil.rmtree(tmp, ignore_errors=True)
    return {**meta, "prepared": "miss"}


class other_jk:
    """Every arm: JK_SELF_UPDATE=never, so no jk installs a release mid-matrix (where no one answers a terminal
    the default is auto: a jk-before home moved from 0.51.1 to 0.52.0 two minutes into a tier-0 run, and 38 of
    its 42 rows measured the new graph). For the jk-before arm also: $JK_BEFORE_HOME as JK_HOME, its bin/ first
    on PATH and a free HTTP port for the run's prepare, agent (whose MCP server inherits the environment) and
    verification; refused when that home's engine is the same version as the default home's."""

    def __init__(self, spec: dict):
        self.on = bool(spec.get("before"))
        self.saved: dict[str, str | None] = {}

    def __enter__(self):
        self.saved["JK_SELF_UPDATE"] = os.environ.get("JK_SELF_UPDATE")
        os.environ["JK_SELF_UPDATE"] = "never"
        if not self.on:
            return self
        home = os.environ.get("JK_BEFORE_HOME")
        if not home or not (Path(home) / "bin" / "jk").exists():
            self.__exit__()
            raise RuntimeError("the jk-before arm needs $JK_BEFORE_HOME, a jk home whose bin/jk is the client")
        before, current = jk_version(Path(home)), jk_version()
        if before is None or before == current:
            self.__exit__()
            raise RuntimeError(f"the jk-before arm's home runs jk {before}, the same as jk's ({current}): "
                               "it updated itself or was replaced; `jk self rollback` in that home puts it back")
        for k in ("JK_HOME", "PATH", "JK_HTTP_PORT"):
            self.saved[k] = os.environ.get(k)
        os.environ["JK_HOME"] = home
        # Two engines beside each other: the other home's would take jk's default HTTP port, and an engine
        # without HTTP serves no MCP. A free port, as jk's own tests run engines.
        os.environ["JK_HTTP_PORT"] = "0"
        os.environ["PATH"] = str(Path(home) / "bin") + os.pathsep + os.environ.get("PATH", "")
        return self

    def __exit__(self, *exc):
        for k, v in self.saved.items():
            if v is None:
                os.environ.pop(k, None)
            else:
                os.environ[k] = v
        return False


JK_SHELL = re.compile(r"^\s*(?:\S*/)?jk\b")
JK_SERVER_ARG = re.compile(r'"(?:ServerName|server_name|serverName|server)":\s*"jk"')


def call_events(ev: dict) -> list[tuple[str, str, bool]]:
    """The tool-call starts and ends one transcript event carries: (``start`` or ``end``, call id, whether the
    call is jk's). Claude Code pairs a tool_use block with a tool_result block; codex an item.started with
    the item.completed of the same id; cursor-agent a started tool_call with its completed one; copilot a
    tool.execution_start with its tool.execution_complete; muse a task scheduled under ``tool:<call id>`` with
    that call's tool.result. agy's tool step carries its own duration:
    (``span``, milliseconds, is jk)."""
    out: list[tuple[str, str, bool]] = []
    message = ev.get("message")
    for block in (message.get("content") or []) if isinstance(message, dict) else []:
        if not isinstance(block, dict):
            continue
        if block.get("type") == "tool_use" and block.get("id"):
            name = str(block.get("name") or "")
            args = block.get("input") if isinstance(block.get("input"), dict) else {}
            # grok calls an MCP tool through use_tool, naming it server__tool.
            inner = str(args.get("tool_name") or "") if name == "use_tool" else name
            out.append(("start", block["id"], inner.startswith(("mcp__jk__", "jk__"))
                        or bool(JK_SHELL.match(str(args.get("command") or "")))))
        elif block.get("type") == "tool_result" and block.get("tool_use_id"):
            out.append(("end", block["tool_use_id"], False))
    kind = ev.get("type")
    item = ev.get("item") if isinstance(ev.get("item"), dict) else None
    if item and item.get("id") and item.get("type") in ("command_execution", "mcp_tool_call"):
        is_jk = item.get("server") == "jk" or bool(JK_SHELL.match(agents._codex_command(str(item.get("command") or ""))))
        if kind == "item.started":
            out.append(("start", item["id"], is_jk))
        elif kind == "item.completed":
            out.append(("end", item["id"], is_jk))
    if kind == "tool_call" and ev.get("call_id") and ev.get("subtype") in ("started", "completed"):
        name, args = agents._cursor_call(ev)
        is_jk = name.startswith("mcp__jk__") or bool(JK_SHELL.match(str(args.get("command") or "")))
        out.append(("start" if ev["subtype"] == "started" else "end", ev["call_id"], is_jk))
    step = ev.get("step_update") if isinstance(ev.get("step_update"), dict) else {}
    if step.get("step_type") == "tool" and step.get("state") in ("DONE", "ERROR") and step.get("duration_seconds"):
        # agy writes a tool step's start and end in one batch, so its own duration is the span.
        params = (step.get("tool_info") or {}).get("parameters") if isinstance(step.get("tool_info"), dict) else {}
        is_jk = step.get("tool_name") == "call_mcp_tool" and bool(JK_SERVER_ARG.search(json.dumps(params or {})))
        out.append(("span", str(int(float(step["duration_seconds"]) * 1000)), is_jk))
    data = ev.get("data") if isinstance(ev.get("data"), dict) else {}
    if kind in ("tool.execution_start", "tool.execution_complete") and data.get("toolCallId"):
        # copilot: the start carries the tool's name, its completion only the call id.
        is_jk = agents._copilot_call(data)[0].startswith("mcp__jk__")
        out.append(("start" if kind == "tool.execution_start" else "end", data["toolCallId"], is_jk))
    payload = ev.get("payload") if isinstance(ev.get("payload"), dict) else {}
    key = str((payload.get("event") or {}).get("idempotency_key") or "") if isinstance(payload.get("event"), dict) else ""
    if ev.get("payload_type") == "task.lifecycle.scheduled" and key.startswith("tool:"):
        out.append(("start", key.removeprefix("tool:"), False))
    elif ev.get("payload_type") == "tool.result" and payload.get("call_id"):
        name = str((payload.get("correlation_facts") or {}).get("tool_name") or "")
        out.append(("end", payload["call_id"], name.startswith("mcp__jk__")))
    return out


def jk_calls(summary: list[dict]) -> int:
    """Calls of jk's MCP tools (``mcp__jk__x``; grok's ``jk__x`` through use_tool), and shell commands that
    run jk, in a driver's transcript spine. A call the server refused (a tool the arm hides) counts too."""
    n = 0
    for entry in summary:
        if "tool_use" not in entry:
            continue
        name = called(entry)
        command = ""
        if name.split("__")[-1] == "Bash":
            try:
                command = str(json.loads(entry.get("input") or "{}").get("command") or "")
            except (json.JSONDecodeError, AttributeError):
                command = str(entry.get("input") or "")
        raw = str(entry.get("tool_use") or "")
        # agy's call_mcp_tool names the server beside the tool; its input may be cut short, so read the text.
        via_agy = raw == "call_mcp_tool" and bool(JK_SERVER_ARG.search(str(entry.get("input") or "")))
        n += name.startswith(("mcp__jk__", "jk__")) or via_agy or bool(JK_SHELL.match(command))
    return n


def timing(transcript: Path, wall_s: float) -> dict:
    """Wall time split from a transcript's ``_t_ms`` stamps: tool time is the union of the intervals from
    each tool call's start event to its end event (call_events), jk time the same over jk's MCP tools and
    shell calls that run jk, model time the rest of the wall. None where the transcript carries no matched
    call ids (a driver whose events do not pair calls with results)."""
    calls: dict[str, tuple[int, bool]] = {}
    spans: list[tuple[int, int, bool]] = []
    try:
        lines = transcript.read_text(errors="replace").splitlines()
    except OSError:
        return {"tool_s": None, "jk_s": None, "model_s": None}
    for line in lines:
        try:
            ev = json.loads(line)
        except json.JSONDecodeError:
            continue
        t = ev.get("_t_ms") if isinstance(ev, dict) else None
        if t is None:
            continue
        for edge, call_id, is_jk in call_events(ev):
            if edge == "span":  # a call that carries its own duration in ms, ending now
                spans.append((t - int(call_id), t, is_jk))
            elif edge == "start":
                calls[call_id] = (t, is_jk)
            elif call_id in calls:
                start, started_jk = calls.pop(call_id)
                spans.append((start, t, started_jk or is_jk))
    if not spans:
        return {"tool_s": None, "jk_s": None, "model_s": None}

    def union(ss: list[tuple[int, int]]) -> float:
        total, end = 0, -1
        for a, b in sorted(ss):
            if b <= end:
                continue
            total += b - max(a, end)
            end = b
        return round(total / 1000, 1)

    tool = union([(a, b) for a, b, _ in spans])
    jk = union([(a, b) for a, b, j in spans if j])
    return {"tool_s": tool, "jk_s": jk, "model_s": round(max(0.0, wall_s - tool), 1)}


@functools.cache
def cli_version(driver: str) -> str | None:
    """The first line of the driver's CLI's ``--version``, so a row says which release ran."""
    try:
        out = subprocess.run([agents.cli(driver), "--version"], capture_output=True, text=True, timeout=30,
                             stdin=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired):
        return None
    lines = (out.stdout or out.stderr).strip().splitlines()
    return lines[0][:80] if lines else None


def run_one(name: str, task: dict, arm: str, run_no: int, ns, run_root: Path) -> dict:
    with other_jk(ARMS[arm]):
        return _run_one(name, task, arm, run_no, ns, run_root)


def _run_one(name: str, task: dict, arm: str, run_no: int, ns, run_root: Path) -> dict:
    spec = ARMS[arm]
    question = task["kind"] == "question"
    tool, extra, hide_graph = spec["tool"], spec["extra"], spec["hide_graph"]
    # A --shell run is another condition: its own directory, so it never replaces the file-tools run's sandbox.
    run_dir = run_root / ns.driver / (arm + "-shell" if ns.shell else arm) / f"{name}.{run_no}"
    if run_dir.exists():
        shutil.rmtree(run_dir)
    sandbox = run_dir / "sandbox"
    row = {"date": ns.date, "driver": ns.driver, "task": name, "kind": task["kind"], "repo": task["repo"],
           "arm": arm, "run": run_no, "model": ns.model, "effort": ns.effort,
           "context": getattr(ns, "context", None), "cli": agents.cli(ns.driver),
           "cli_version": cli_version(ns.driver), "outcome": "error", "finding": "",
           "sandbox": str(sandbox), "host": benchtools.host_id(), "jk_build": jk_build_id(), "jk_version": jk_version(),
           "test_excluded": test_excludes() or None, "anchor_tail": anchor_tail() or None,
           # A re-pinned corpus is other code: its rows are a series of their own.
           "corpus": corpus_rev(task) or None}
    try:
        # A question needs the classes (the graph's compiled facts), not a test run.
        prep = prepare(task, tool, question, sandbox)
        code, out = prep["code"], prep["out"]
        row["baseline_wall_s"] = prep["warm"]
        row["prepared"] = prep["prepared"]
        expected_red = task.get("baseline") == "red"
        if (code != 0) != expected_red:
            state = "red" if code else "green"
            row["finding"] = f"baseline is {state} before the agent, expected {task.get('baseline', 'green')}: {out[-300:]}"
            return row
        if tool == "jk":
            if prep["gcode"] != 0:
                raise RuntimeError(f"jk graph build failed: {prep.get('gout', '')}")
            row["graph_edges"] = prep["edges"]
            # What a jk user's repository holds: jk's AGENTS.md section. Claude Code reads AGENTS.md
            # itself; a CLAUDE.md import of it adds context and nothing else.
            write_agents_md(sandbox)
            if spec.get("agents_line"):
                agents_md = sandbox / "AGENTS.md"
                text = agents_md.read_text()
                anchor = "- Before handing work back:"
                at = text.index(anchor)
                end = text.index("\n", at) + 1
                agents_md.write_text(text[:end] + spec["agents_line"] + "\n" + text[end:])
            for rel, text in spec.get("files", {}).items():
                target = sandbox / rel
                target.parent.mkdir(parents=True, exist_ok=True)
                target.write_text(text)
            if spec.get("strip_usages"):
                agents_md = sandbox / "AGENTS.md"
                # The whole bullet: its first line names jk code usages, and its indented lines continue it.
                kept, dropping = [], False
                for line in agents_md.read_text().splitlines(keepends=True):
                    if line.startswith("- "):
                        dropping = "jk code usages" in line
                    elif not line.startswith("  "):
                        dropping = False
                    if not dropping:
                        kept.append(line)
                agents_md.write_text("".join(kept))
        if "graphify" in extra:
            gcode, gout, gwall = sh(["graphify", "update", "."], sandbox, 3600)
            row["graphify_index_s"] = round(gwall, 1)
            if gcode != 0:
                row["finding"] = f"graphify index failed: {gout[-300:]}"
                return row
        install_hooks(spec["hooks"], sandbox, run_dir)
        server, servers = mcp_servers(tool, extra, hide_graph, sandbox, spec.get("extended", False))
        preflight(spec, tool, sandbox, servers.get(server), row.get("graph_edges"))
        transcript = run_dir / "transcript.jsonl"
        shell = ns.shell or ns.driver in SHELL_DRIVERS
        agents.TASK = agents.Task(
            system=((QUESTION_SHELL_PROMPT if shell else QUESTION_PROMPT) if question
                    else SHELL_PROMPT if shell else SYSTEM_PROMPT).format(
                tool_label=TOOL_LABEL[tool], sandbox=sandbox, server=server) + spec["prompt"],
            user=task["prompt"].strip(),
            servers=servers,
            shell=shell,
            hide_graph=bool(spec.get("hide_graph")),
            context=getattr(ns, "context", None))
        if tool == "jk":
            # Every jk arm starts timing with a warm engine and graph worker: a prepared sandbox copied
            # from the cache ran no jk, and a cold engine or worker would land in one arm's first call.
            wcode, _, wwall = sh(["jk", "-u", "-x", "graph", "build"], sandbox, 900)
            row["warmup_s"] = round(wwall, 1)
        started = time.monotonic()
        try:
            res = DRIVERS[ns.driver](tool, sandbox, ns.model, ns.max_turns, ns.max_minutes * 60, transcript,
                                     effort=ns.effort)
        finally:
            agents.TASK = None
        row["wall_s"] = round(time.monotonic() - started, 1)
        row.update(timing(transcript, row["wall_s"]))
        usage = res.usage or {}
        texts = [e["text"] for e in res.transcript if "text" in e]
        reply = (texts[-1] if texts else "").strip()
        row.update(
            turns=res.turns, input_tokens=usage.get("input_tokens", 0),
            output_tokens=int(usage.get("output_tokens") or 0),
            cache_read_tokens=usage.get("cache_read_input_tokens", 0),
            cache_write_tokens=usage.get("cache_creation_input_tokens", 0),
            reasoning_tokens=agents.reasoning_count(usage, res.extra.get("model_usage")),
            cost_usd=None if res.cost_usd is None else round(res.cost_usd, 4),
            claimed=bool(re.search(r"(?m)^\s*DONE\b", reply)), reply=reply[:300],
            agent_finding=res.finding, jk_calls=jk_calls(res.transcript), **navigation(res.transcript, sandbox))
        right = code_tool(task, arm)
        row.update(code_tool=right, code_tool_calls=code_tool_calls(res.transcript, right) if right else None,
                   tool_errors=tool_errors(transcript, ns.driver),
                   turn_cap=(res.finding or "").startswith("turn budget exhausted")
                   or res.extra.get("subtype") == "error_max_turns")
        # A router (copilot's Fusion) answers with models of its own choosing: the row names them.
        for key in ("routed_models", "copilot_aiu"):
            if res.extra.get(key) is not None:
                row[key] = res.extra[key]
        if res.extra.get("abort"):
            row["finding"] = f"the {ns.driver} CLI did not start: {res.finding}"[:300]
            return row
        if usage:
            row["tokens"] = (row["input_tokens"] + row["output_tokens"] + row["cache_read_tokens"]
                             + row["cache_write_tokens"])
            row.update(cost.estimate(row))
        else:
            # The agent was stopped before it reported usage (cursor-agent killed at the turn budget):
            # its tokens are unknown, and a 0 would pull the cell's median down.
            for key in ("input_tokens", "output_tokens", "cache_read_tokens", "cache_write_tokens",
                        "reasoning_tokens", "tokens"):
                row[key] = None
        hook_log = run_dir / "hook.jsonl"
        if hook_log.exists():
            fired = [json.loads(line) for line in hook_log.read_text().splitlines() if line.strip()]
            row["hook_calls"] = len(fired)
            row["hook_injections"] = sum(1 for h in fired if h.get("injected"))
            row["hook_chars"] = sum(h.get("injected", 0) for h in fired)
        if question:
            row.update(grade(task, sandbox))
            row["accepted"] = row["f1"] >= 0.9
            row["outcome"] = "green" if row["accepted"] else ("claimed" if row["claimed"] else "red")
            return row
        hidden = TASK_FILES / name / tool
        if not hidden.exists():
            hidden = TASK_FILES / name / "all"
        if hidden.exists():
            shutil.copytree(hidden, sandbox, dirs_exist_ok=True)
        for rel in task.get("restore", []):
            # The suite as shipped decides, not as the agent may have edited it.
            src = CORPUS / task["repo"] / rel
            shutil.rmtree(sandbox / rel, ignore_errors=True)
            shutil.copytree(src, sandbox / rel)
        code, out, verify = sh(test_cmd(tool, verify=True, task=task), sandbox, 3600)
        (run_dir / "verify.log").write_text(out, encoding="utf-8")
        row["verify_wall_s"] = round(verify, 1)
        row["accepted"] = code == 0
        row["outcome"] = "green" if code == 0 else ("claimed" if row["claimed"] else "red")
        diff = subprocess.run(["git", "diff", "--stat", "HEAD"], cwd=sandbox, capture_output=True, text=True).stdout
        row["diff_files"] = max(0, len(diff.strip().splitlines()) - 1)
    except Exception as e:  # noqa: BLE001 - a broken run is a row, not a crash of the matrix
        row["finding"] = f"{type(e).__name__}: {e}"[:300]
    return row


def prune(row: dict) -> None:
    """Delete a finished run's sandbox once its row is written, keeping the agent's diff beside the
    transcript. Only a red or claimed run keeps its sandbox, for --reverify; a sandbox is a full repository
    with its build output, a few hundred MB, and a matrix of them fills the disk."""
    if row.get("outcome") in ("red", "claimed") or not row.get("sandbox"):
        return
    sandbox = Path(row["sandbox"])
    if not sandbox.is_dir():
        return
    if (sandbox / ".git").exists():
        diff = subprocess.run(["git", "diff", "HEAD"], cwd=sandbox, capture_output=True, text=True).stdout
        (sandbox.parent / "diff.patch").write_text(diff, encoding="utf-8")
    shutil.rmtree(sandbox, ignore_errors=True)


def reverify(out_dir: Path) -> None:
    """Re-run verification in every kept sandbox whose row is not green, and rewrite the rows."""
    path = out_dir / "rows.jsonl"
    rows = [json.loads(line) for line in path.read_text().splitlines()]
    for r in rows:
        if r.get("outcome") in ("green", "error") or "tokens" not in r:
            continue
        sandbox = Path(r["sandbox"])
        tool = ARMS[r["arm"]]["tool"]
        code, out, wall = sh(test_cmd(tool, verify=True), sandbox, 3600)
        (sandbox.parent / "verify.log").write_text(out, encoding="utf-8")
        r["verify_wall_s"] = round(wall, 1)
        r["accepted"] = code == 0
        r["outcome"] = "green" if code == 0 else ("claimed" if r.get("claimed") else "red")
        r["reverified"] = True
        print(f"{r.get('driver')} {r['task']} {r['arm']} #{r['run']}: {r['outcome']}")
    path.write_text("".join(json.dumps(r) + "\n" for r in rows))
    render(out_dir)


def render(out_dir: Path) -> None:
    rows = [json.loads(line) for line in (out_dir / "rows.jsonl").read_text().splitlines()]
    lines = [f"# Change tasks — {out_dir.name}", "",
             "Medians over runs. Tokens are input + output + cache read + cache write as the API reports them; "
             "a run stopped before it reported usage is left out of the token medians and counted as unreported. "
             "Graph share is graph calls over graph + Grep/Glob/Read calls. Wall is the agent's start to its "
             "final answer; tool s and jk s are the time inside tool calls and inside jk calls (MCP and shell) "
             "from the transcript's stamps, model s the rest; every jk arm starts on a warm engine.", "",
             "| Driver | Task | Arm | Runs | Green | Median tokens | Uncached in | Output | Turns | Wall s | Model s "
             "| Tool s | jk s | Graph share | Median F1 |",
             "|---|---|---|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|"]
    for driver, task, arm in sorted({(r.get("driver", "claude-code"), r["task"], r["arm"]) for r in rows}):
        rs = [r for r in rows if (r.get("driver", "claude-code"), r["task"], r["arm"]) == (driver, task, arm)
              and "tokens" in r]
        if not rs:
            continue
        def med(k: str) -> float:
            known = [r[k] for r in rs if r.get(k) is not None]
            return statistics.median(known) if known else float("nan")
        unknown = sum(1 for r in rs if r.get("tokens") is None)
        shares = [r["graph_share"] for r in rs if r.get("graph_share") is not None]
        lines.append(f"| {driver} | {task} | {arm} | {len(rs)} | {sum(r['outcome'] == 'green' for r in rs)} "
                     f"| {med('tokens'):.0f}{f' ({unknown} unreported)' if unknown else ''} "
                     f"| {med('input_tokens'):.0f} | {med('output_tokens'):.0f} "
                     f"| {med('turns'):.0f} | {med('wall_s'):.0f} | {med('model_s'):.0f} | {med('tool_s'):.0f} "
                     f"| {med('jk_s'):.0f} "
                     f"| {statistics.median(shares) if shares else 0:.2f} "
                     f"| {statistics.median(r['f1'] for r in rs) if all('f1' in r for r in rs) else '-'} |")
    (out_dir / "TABLE.md").write_text("\n".join(lines) + "\n")
    print((out_dir / "TABLE.md").read_text())


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--list", action="store_true")
    ap.add_argument("--task", action="append")
    ap.add_argument("--arm", action="append", choices=sorted(ARMS))
    ap.add_argument("--runs", type=int, default=1)
    ap.add_argument("--first-run", type=int, default=1, help="number the runs from here (keeps earlier runs of the day)")
    ap.add_argument("--driver", default="claude-code", choices=sorted(DRIVERS))
    ap.add_argument("--model", help="default per driver")
    ap.add_argument("--effort", help="default per driver")
    ap.add_argument("--context", type=int, help="context window in tokens, for a CLI that takes one (grok); recorded")
    ap.add_argument("--max-turns", type=int, default=60)
    ap.add_argument("--max-minutes", type=int, default=30)
    ap.add_argument("--shell", action="store_true",
                    help="give the agent Bash too (Claude Code), as graphify's install expects")
    ap.add_argument("--render", action="store_true")
    ap.add_argument("--reverify", action="store_true", help="re-judge kept sandboxes that are not green")
    ap.add_argument("--out")
    ns = ap.parse_args()
    ns.date = dt.date.today().isoformat()
    ns.model = ns.model or DEFAULT_MODEL[ns.driver]
    ns.effort = ns.effort or DEFAULT_EFFORT[ns.driver]
    out_dir = Path(ns.out) if ns.out else HERE / "results" / f"{ns.date}-change-tasks"
    all_tasks = tasks()
    if ns.list:
        for name, t in all_tasks.items():
            print(f"{name:32} {t['repo']:24} {t['kind']}")
        return 0
    if ns.render:
        render(out_dir)
        return 0
    if ns.reverify:
        benchtools.resolve(allow_stale=True, need=("maven",))
        reverify(out_dir)
        return 0
    cli = agents.cli(ns.driver)
    if not shutil.which(cli):
        print(f"the `{cli}` CLI is not on PATH", file=sys.stderr)
        return 2
    out_dir.mkdir(parents=True, exist_ok=True)
    if any(ARMS[a]["tool"] == "mvn" for a in (ns.arm or ARMS)):
        # The wrappers run the pinned Maven, provisioned as the agent-loop harness does.
        benchtools.resolve(allow_stale=True, need=("maven",))
    run_root = HOME / ns.date
    # Apache RAT fails on any file a graph tool or an agent package adds to the sandbox (graphify-out/,
    # CLAUDE.md), which no task is about; every Maven run skips it, the agent's own and the shell's.
    os.environ["MAVEN_ARGS"] = (os.environ.get("MAVEN_ARGS", "") + " -Drat.skip=true").strip()
    names = ns.task or list(all_tasks)
    with (out_dir / "rows.jsonl").open("a") as f:
        for run_no in range(ns.first_run, ns.first_run + ns.runs):
            for name in names:
                for arm in ns.arm or list(ARMS):
                    tool = ARMS[arm]["tool"]
                    if tool not in all_tasks[name].get("tools", ["jk", "mvn"]):
                        continue
                    row = run_one(name, all_tasks[name], arm, run_no, ns, run_root)
                    f.write(json.dumps(row) + "\n")
                    f.flush()
                    prune(row)
                    print(f"{ns.driver} {name} {arm} #{run_no}: {row['outcome']} tokens={row.get('tokens')} "
                          f"turns={row.get('turns')} graph_share={row.get('graph_share')} {row['finding']}")
    render(out_dir)
    return 0


if __name__ == "__main__":
    sys.exit(main())
