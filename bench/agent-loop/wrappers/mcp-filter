#!/usr/bin/env python3
"""A stdio MCP server minus some of its tools: `mcp-filter --drop a,b -- <server command...>`.

Forwards newline-delimited JSON-RPC both ways. A `tools/list` reply loses the dropped tools, and a
`tools/call` naming one is answered "unknown tool" without reaching the server, so an arm that
should not have a tool cannot call it whatever its client does with allow-lists.
"""

from __future__ import annotations

import json
import subprocess
import sys
import threading


def main() -> int:
    args = sys.argv[1:]
    if "--" not in args or args[:1] != ["--drop"]:
        print("usage: mcp-filter --drop a,b -- <command...>", file=sys.stderr)
        return 2
    drop = set(args[1].split(","))
    cmd = args[args.index("--") + 1:]
    child = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True, bufsize=1)
    lock = threading.Lock()

    def emit(msg: dict) -> None:
        with lock:
            sys.stdout.write(json.dumps(msg) + "\n")
            sys.stdout.flush()

    def from_server() -> None:
        assert child.stdout
        for line in child.stdout:
            try:
                msg = json.loads(line)
            except json.JSONDecodeError:
                continue
            result = msg.get("result")
            if isinstance(result, dict) and isinstance(result.get("tools"), list):
                result["tools"] = [t for t in result["tools"] if t.get("name") not in drop]
            emit(msg)
        sys.stdout.flush()

    threading.Thread(target=from_server, daemon=True).start()
    assert child.stdin
    for line in sys.stdin:
        try:
            msg = json.loads(line)
        except json.JSONDecodeError:
            continue
        if msg.get("method") == "tools/call" and (msg.get("params") or {}).get("name") in drop:
            if "id" in msg:
                emit({"jsonrpc": "2.0", "id": msg["id"],
                      "error": {"code": -32602, "message": f"unknown tool: {msg['params']['name']}"}})
            continue
        child.stdin.write(json.dumps(msg) + "\n")
        child.stdin.flush()
    child.stdin.close()
    return child.wait()


if __name__ == "__main__":
    sys.exit(main())
