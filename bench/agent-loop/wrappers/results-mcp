#!/usr/bin/env python3
"""A minimal MCP server over the wrapper's output: stdio, JSON-RPC 2.0, newline-delimited.

Tools mirror the jk trio an agent reaches for first: `run` reruns the build through
`mvn-results` / `gradle-results`, `results` returns the latest `target/jk-results.md` and
`diagnostics` returns the parsed errors and failing tests from `target/jk-diagnostics.json`.
Bind the project with `--dir`; the wrapper is `--tool`, or whichever build file the directory
holds.
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from pathlib import Path

PROTOCOL_VERSION = "2025-06-18"
HERE = Path(__file__).resolve().parent

TOOLS = [
    {
        "name": "run",
        "description": (
            "Run the build and tests (Maven `test` or Gradle `test` through the wrapper), wait "
            "for it, and return the results markdown it wrote. Call after every edit."
        ),
        "inputSchema": {
            "type": "object",
            "properties": {
                "args": {
                    "type": "array",
                    "items": {"type": "string"},
                    "description": "Tool arguments; default the `test` goal/task.",
                },
                "timeout_s": {"type": "integer", "description": "Wait timeout seconds; default 1800."},
            },
            "additionalProperties": False,
        },
    },
    {
        "name": "results",
        "description": (
            "High-level markdown for the last Maven or Gradle run (same shape as jk's "
            "target/jk-results.md): outcome, why it failed, tests, compiler errors with "
            "file:line:col, failed steps. Start here."
        ),
        "inputSchema": {"type": "object", "properties": {}, "additionalProperties": False},
    },
    {
        "name": "diagnostics",
        "description": (
            "Structured compiler and test failures from the last run: each diagnostic with "
            "task, module, file, line, col and message; each failing test with class, name, "
            "message and stack; the failed steps."
        ),
        "inputSchema": {
            "type": "object",
            "properties": {
                "severity": {
                    "type": "string",
                    "enum": ["error", "warning", "all"],
                    "description": "Which diagnostics to include; default error.",
                }
            },
            "additionalProperties": False,
        },
    },
]


def read_text(path: Path) -> str | None:
    return path.read_text(encoding="utf-8", errors="replace") if path.exists() else None


def run_tool(project: Path, tool: str, args: dict) -> dict:
    cmd = [str(HERE / f"{tool}-results"), *args.get("args", [])]
    timeout = int(args.get("timeout_s", 1800))
    env = {**os.environ, "RESULTS_QUIET": "1"}
    try:
        proc = subprocess.run(cmd, cwd=project, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE,
                              text=True, errors="replace", timeout=timeout, env=env)
        exit_code, note = proc.returncode, proc.stderr.strip()
    except subprocess.TimeoutExpired:
        exit_code, note = 124, f"timed out after {timeout}s"
    text = read_text(project / "target" / "jk-results.md") or f"{tool}-results wrote no results file\n{note}"
    return {
        "content": [{"type": "text", "text": text}],
        "structuredContent": {"schema": 1, "type": "job", "tool": tool, "exitCode": exit_code, "success": exit_code == 0},
    }


def call_tool(project: Path, tool: str, name: str, args: dict) -> dict:
    target = project / "target"
    if name == "run":
        return run_tool(project, tool, args)
    if name == "results":
        text = read_text(target / "jk-results.md")
        if text is None:
            return error_result("no results yet — run mvn-results or gradle-results first")
        return {"content": [{"type": "text", "text": text}]}
    if name == "diagnostics":
        text = read_text(target / "jk-diagnostics.json")
        if text is None:
            return error_result("no diagnostics yet — run mvn-results or gradle-results first")
        data = json.loads(text)
        severity = args.get("severity", "error")
        if severity != "all":
            data["diagnostics"] = [d for d in data["diagnostics"] if d["severity"] == severity]
        return {"content": [{"type": "text", "text": json.dumps(data, indent=1)}]}
    return error_result(f"unknown tool: {name}")


def error_result(message: str) -> dict:
    return {"content": [{"type": "text", "text": message}], "isError": True}


def handle(project: Path, tool: str, req: dict) -> dict | None:
    method = req.get("method")
    rid = req.get("id")
    if method == "initialize":
        return reply(rid, {
            "protocolVersion": PROTOCOL_VERSION,
            "capabilities": {"tools": {}},
            "serverInfo": {"name": "results-mcp", "version": "1"},
        })
    if method == "ping":
        return reply(rid, {})
    if method == "tools/list":
        return reply(rid, {"tools": TOOLS})
    if method == "tools/call":
        params = req.get("params") or {}
        return reply(rid, call_tool(project, tool, params.get("name", ""), params.get("arguments") or {}))
    if method and method.startswith("notifications/"):
        return None
    if rid is None:
        return None
    return {"jsonrpc": "2.0", "id": rid, "error": {"code": -32601, "message": f"method not found: {method}"}}


def reply(rid, result: dict) -> dict:
    return {"jsonrpc": "2.0", "id": rid, "result": result}


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n", 1)[0])
    ap.add_argument("--dir", default=".", help="project directory whose target/ holds the wrapper's output")
    ap.add_argument("--tool", choices=("mvn", "gradle"), help="which wrapper `run` invokes; default from the build file present")
    ns = ap.parse_args()
    project = Path(ns.dir).resolve()
    tool = ns.tool or ("mvn" if (project / "pom.xml").exists() else "gradle")
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            req = json.loads(line)
        except json.JSONDecodeError:
            out = {"jsonrpc": "2.0", "id": None, "error": {"code": -32700, "message": "parse error"}}
        else:
            out = handle(project, tool, req)
        if out is not None:
            sys.stdout.write(json.dumps(out) + "\n")
            sys.stdout.flush()
    return 0


if __name__ == "__main__":
    sys.exit(main())
