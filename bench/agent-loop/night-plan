#!/usr/bin/env python3
"""The agent benches a night owes, in order, each with the wall time its earlier runs took.

    bench/agent-loop/night-plan plan     # one line per cell, tab-separated
    bench/agent-loop/night-plan agents   # one line per agent: driver, model, effort, prescription arm
    bench/agent-loop/night-plan tools    # exit 1 when the installed jk's MCP lists lack a tool a step needs
    bench/agent-loop/night-plan corpus   # the directory of the corpus repositories the tasks run on

scripts/bench-night.sh runs the plan. Each line is one cell, one run of one agent on one task and arm:

    step  tier  driver  arm  task  repo  runs  first_run  model  effort  est_s  source

Every agent runs its pinned model and effort (change-tasks' DEFAULT_MODEL and DEFAULT_EFFORT), one run
a cell, never repeated. The tiers:

    0  smoke-test: the two-task fixture (task `smoke`, repo `-`)
    1  a screen: TIER1, the code questions, a rename and the four workbench refactorings
    2  a sliver of the collection: the other tasks the published claims use

A task runs "with the tools" on the agent's prescription arm, or on jk-graph for a refactoring, whose
tools only the extended list carries; "without" is jk-nograph, no JumpKick code tools. The steps:

    1  the new agent (NIGHT_FIRST, default copilot) alone, tiers 0, 1 and 2 with the tools, so a problem
       with it shows first
    2  without the tools: every task of tiers 1 and 2, every agent (NIGHT_NOGRAPH=0 leaves it out)
    3  with the tools: tiers 0, 1 and 2, every agent but the new one, which step 1 ran

Within a step, tier 1 comes before tier 2 and each task runs every agent before the next task, so a
deadline cuts tasks, not agents. Step 4 has no cells here: bench-night.sh runs its commands from a file.

`est_s` is the cell's seconds: the median of baseline, warmup, agent and verification seconds over the
newest series of that cell in results/*/rows.jsonl, the model's own runs first; without one, the median
over the same driver and arm's cells on the same repository and kind (question or edit), then over all
that driver and arm's cells; then any agent's cells of the same task and arm, of the same repository,
kind and arm, of the same repository and kind on any arm; then the run's --max-minutes cap. A smoke
cell's comes from the smoke rows under $AGENT_LOOP_HOME/smoke/. `source` says which. Sandbox copying
is not in the rows and not in the estimate.

Environment: NIGHT_DRIVERS (default every agent change-tasks pins), NIGHT_FIRST, NIGHT_SKIP (agents left
out of steps 2 and 3), NIGHT_NOGRAPH, NIGHT_RESULTS (the results directory, default results/ beside this
file), NIGHT_MAX_MINUTES (default 30).
"""
from __future__ import annotations

import ast
import importlib.util
import json
import os
import statistics
import sys
import tomllib
from pathlib import Path

HERE = Path(__file__).resolve().parent
# Tier 1, the screen: a caller question and an impact question, a rename, and the four workbench refactorings.
TIER1 = ["petclinic-callers-addpet", "cl-impact-ispackage", "petclinic-rename-telephone",
         "petclinic-delete-dead-code", "petclinic-move-phone-format", "petclinic-pullup-display-name",
         "petclinic-extract-interface-contact"]
REFACTOR_KINDS = {"delete", "move", "pull-up", "extract-interface"}
# The tools each surface must list: the loop and graph cards, then the refactorings.
NEEDED = {"default": ["build", "usages"], "extended": ["delete", "move", "pull_up", "extract_interface"]}
FIRST_RUN = {1: 100, 2: 200, 3: 300}
SMOKE_TASKS = 2
SMOKE_CAP_S = 4 * 60


def _scoreboard_agents():
    spec = importlib.util.spec_from_file_location("night_agents", HERE.parent / "scoreboard.d" / "agents.py")
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)  # type: ignore[union-attr]
    return mod


def pins() -> tuple[dict[str, str], dict[str, str]]:
    """change-tasks' DEFAULT_MODEL and DEFAULT_EFFORT: every agent's pinned model and effort."""
    text = (HERE / "change-tasks").read_text()

    def table(name: str) -> dict[str, str]:
        start = text.index(f"{name} = ") + len(name) + 3
        return ast.literal_eval(text[start:text.index("}", start) + 1])

    return table("DEFAULT_MODEL"), table("DEFAULT_EFFORT")


def _read(files) -> list[dict]:
    out = []
    for f in sorted(files):
        out += [json.loads(line) for line in f.read_text().splitlines() if line.strip()]
    return out


def _rows(rows: list[dict], tasks: dict) -> dict[tuple[str, str, str, str], list[dict]]:
    """Every (driver, arm, task, model) cell's newest series."""
    by: dict[tuple[str, str, str, str], dict[tuple[str, int], list[dict]]] = {}
    for r in rows:
        if r.get("task") not in tasks or r.get("wall_s") is None:
            continue
        series = (str(r.get("date", "")), int(r.get("run") or 0) // 100)
        key = (r.get("driver", "claude-code"), r["arm"], r["task"], str(r.get("model")))
        by.setdefault(key, {}).setdefault(series, []).append(r)
    return {k: v[max(v)] for k, v in by.items()}


def _seconds(r: dict) -> float:
    return sum(float(r.get(k) or 0) for k in ("baseline_wall_s", "warmup_s", "wall_s", "verify_wall_s"))


def _family(spec: dict) -> str:
    return "question" if spec.get("kind") == "question" else "edit"


def estimate(cells: dict, tasks: dict, driver: str, arm: str, task: str, model: str, cap_s: float) -> tuple[float, str]:
    """Seconds one run of the cell takes, and where that number came from: the model's own runs first."""
    def med(rs: list[dict]) -> float:
        return statistics.median(_seconds(r) for r in rs)

    spec = tasks[task]
    tiers = [
        lambda d, a, t: d == driver and a == arm and t == task,
        lambda d, a, t: (d == driver and a == arm and tasks[t]["repo"] == spec["repo"]
                         and _family(tasks[t]) == _family(spec)),
        lambda d, a, t: d == driver and a == arm,
    ]
    for same_model in (True, False):
        for i, tier in enumerate(tiers):
            hits = {k: v for k, v in cells.items() if tier(*k[:3]) and (k[3] == model or not same_model)}
            if not hits:
                continue
            if i == 0:
                rs = hits[max(hits, key=lambda k: (str(hits[k][0].get("date")), int(hits[k][0].get("run") or 0)))]
                n = len(rs)
                return med(rs), f"cell {rs[0].get('date')} ({n} run{'s' if n != 1 else ''}, {rs[0].get('model')})"
            what = f"{spec['repo']} {_family(spec)}s" if i == 1 else "all cells"
            models = sorted({k[3] for k in hits})
            return (statistics.median(med(v) for v in hits.values()),
                    f"{what} of {driver}/{arm} ({len(hits)} cells, {', '.join(models)})")
    like = f"{spec['repo']} {_family(spec)}s"
    for what, near in ((f"{task} on {arm}", lambda a, t: a == arm and t == task),
                       (f"{like} on {arm}", lambda a, t: a == arm and _like(tasks[t], spec)),
                       (f"{like} on any arm", lambda a, t: _like(tasks[t], spec))):
        others = {k: v for k, v in cells.items() if near(k[1], k[2])}
        if others:
            return statistics.median(med(v) for v in others.values()), f"{what} by any agent ({len(others)} cells)"
    return cap_s, "no runs: the time cap"


def _like(a: dict, b: dict) -> bool:
    return a["repo"] == b["repo"] and _family(a) == _family(b)


def smoke_estimate(rows: list[dict], driver: str, model: str) -> tuple[float, str]:
    """Seconds of one smoke-test of the two default tasks: that model's median run, else every agent's."""
    for mine, what in ((True, f"{driver}'s smoke runs"), (False, "every agent's smoke runs")):
        rs = [_seconds(r) for r in rows if r.get("wall_s") is not None
              and (not mine or (r.get("driver") == driver and r.get("model") == model))]
        if rs:
            return SMOKE_TASKS * statistics.median(rs), f"{what} ({len(rs)})"
    return SMOKE_TASKS * SMOKE_CAP_S, "no smoke runs: the time cap"


def claimed(tasks: dict, rows: list[dict], graph_question) -> list[str]:
    """The tasks the published claims use: graph questions and renames with a measured row, whatever its model
    (the scoreboard keeps only the pinned models' rows, so a new pin would otherwise empty the list)."""
    out = set()
    for r in rows:
        t = r.get("task")
        if t in tasks and "accepted" in r:
            kind = tasks[t].get("kind", "")
            if graph_question(t, kind) or kind.startswith("rename"):
                out.add(t)
    return sorted(out)


def plan() -> list[tuple]:
    sb = _scoreboard_agents()
    tasks = tomllib.loads((HERE / "tasks.toml").read_text())["tasks"]
    results = Path(os.environ.get("NIGHT_RESULTS") or HERE / "results")
    rows = _read(results.glob("*/rows.jsonl"))
    cells = _rows(rows, tasks)
    sys.path.insert(0, str(HERE.parent))
    import benchtools  # noqa: PLC0415

    smoke_rows = _read((benchtools.scratch("AGENT_LOOP_HOME", "agent-loop") / "smoke").glob("*/rows.jsonl"))
    cap_s = 60.0 * int(os.environ.get("NIGHT_MAX_MINUTES") or 30)
    models, efforts = pins()
    drivers = (os.environ.get("NIGHT_DRIVERS") or " ".join(models)).split()
    first = os.environ.get("NIGHT_FIRST", "copilot")
    skip = set((os.environ.get("NIGHT_SKIP") or "").split())
    tier2 = [t for t in claimed(tasks, rows, sb._graph_question) if t not in TIER1]
    out = []

    def with_tools(driver: str, task: str) -> str:
        return "jk-graph" if tasks[task].get("kind") in REFACTOR_KINDS else sb.PRESCRIPTION.get(driver, "jk")

    def smoke(step: int, driver: str) -> None:
        est, source = smoke_estimate(smoke_rows, driver, models[driver])
        out.append((step, 0, driver, sb.PRESCRIPTION.get(driver, "jk"), "smoke", "-", 1, FIRST_RUN[step],
                    models[driver], efforts[driver], round(est), source))

    def add(step: int, tier: int, driver: str, arm: str, task: str) -> None:
        one, source = estimate(cells, tasks, driver, arm, task, models[driver], cap_s)
        out.append((step, tier, driver, arm, task, tasks[task]["repo"], 1, FIRST_RUN[step], models[driver],
                    efforts[driver], round(one), source))

    if first in drivers:
        smoke(1, first)
        for tier, names in ((1, TIER1), (2, tier2)):
            for task in names:
                add(1, tier, first, with_tools(first, task), task)
    rest = [d for d in drivers if d not in skip]
    if os.environ.get("NIGHT_NOGRAPH") != "0":
        for tier, names in ((1, TIER1), (2, tier2)):
            for task in names:
                for driver in rest:
                    add(2, tier, driver, "jk-nograph", task)
    rest = [d for d in rest if d != first]
    for driver in rest:
        smoke(3, driver)
    for tier, names in ((1, TIER1), (2, tier2)):
        for task in names:
            for driver in rest:
                add(3, tier, driver, with_tools(driver, task), task)
    return out


def tools() -> int:
    """The installed jk's default and extended tools/list must carry every tool a step's arms call."""
    sys.path.insert(0, str(HERE))
    from harnesslib.mcp import StdioMcp  # noqa: PLC0415

    missing = []
    for surface, names in NEEDED.items():
        client = StdioMcp(["jk", "mcp"], cwd=HERE)
        try:
            listed = client.request("tools/list", {"extended": True} if surface == "extended" else {}).get("tools") or []
        finally:
            client.close()
        have = {t.get("name") for t in listed}
        missing += [f"{name} ({surface} list)" for name in names if name not in have]
    if missing:
        print("the installed jk's MCP lacks: " + ", ".join(missing), file=sys.stderr)
        return 1
    return 0


def main() -> int:
    what = sys.argv[1] if len(sys.argv) > 1 else ""
    if what == "plan":
        for line in plan():
            print("\t".join(str(x) for x in line))
        return 0
    if what == "agents":
        sb = _scoreboard_agents()
        models, efforts = pins()
        for driver in (os.environ.get("NIGHT_DRIVERS") or " ".join(models)).split():
            print("\t".join([driver, models[driver], efforts[driver], sb.PRESCRIPTION.get(driver, "jk")]))
        return 0
    if what == "tools":
        return tools()
    if what == "corpus":
        sys.path.insert(0, str(HERE.parent))
        import benchtools  # noqa: PLC0415

        print(benchtools.scratch("GRAPH_RETRIEVAL_HOME", "graph-retrieval") / "repos")
        return 0
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
