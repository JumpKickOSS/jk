#!/usr/bin/env python3
"""A night of benches in tables, computed from its rows: every cell, then per agent and arm, then per
task with the code tools against without them.

    bench/agent-loop/night-summary --since 2026-11-22

The rows are change-tasks' rows in results/<date>-change-tasks/ (NIGHT_RESULTS overrides results/)
numbered as night-plan numbers a night's runs (100 to 399), and the smoke rows under
$AGENT_LOOP_HOME/smoke/<date>/, of every date from --since on. A cell run twice counts once, its newest
row. Dollars are each row's tokens at the API list prices of the price table built into JumpKick, as
published on the date the header names, whatever the CLI reported or the row was priced at.

The tool hit rate counts the cells where a JumpKick code tool is the right move and the arm offers it
(the row's `code_tool`): a hit is a cell whose agent called that tool at least once. A no-code-tools
cell has no right tool, so its hit is `n/a`. Rows written before the harness recorded a column show `-`
in it.
"""
from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import sys
import tomllib
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE.parent))
sys.path.insert(0, str(HERE))
import benchtools  # noqa: E402
from harnesslib import cost  # noqa: E402

NIGHT_RUNS = range(100, 400)


def rows(since: dt.date) -> list[dict]:
    results = Path(os.environ.get("NIGHT_RESULTS") or HERE / "results")
    smoke = benchtools.scratch("AGENT_LOOP_HOME", "agent-loop") / "smoke"
    files = [(f, True) for f in results.glob("*-change-tasks/rows.jsonl")]
    files += [(f, False) for f in smoke.glob("*/rows.jsonl")]
    newest: dict[tuple, dict] = {}
    for f, night_runs in sorted(files):
        for line in f.read_text().splitlines():
            if not line.strip():
                continue
            r = json.loads(line)
            try:
                if dt.date.fromisoformat(str(r.get("date"))) < since:
                    continue
            except ValueError:
                continue
            if night_runs and int(r.get("run") or 0) not in NIGHT_RUNS:
                continue
            newest[(night_runs, r.get("driver", "claude-code"), r.get("task"), r.get("arm"), r.get("model"))] = r
    return list(newest.values())


def usd(r: dict) -> float | None:
    return cost.estimate(r).get("cost_est_usd")


def hit(r: dict) -> bool | None:
    """Whether the agent called the right code tool; None where no code tool is the right move or the row
    predates the column."""
    if not r.get("code_tool"):
        return None
    return bool(r.get("code_tool_calls"))


def fmt(v, digits: int = 0) -> str:
    if v is None:
        return "-"
    if isinstance(v, bool):
        return "yes" if v else "no"
    if isinstance(v, float):
        return f"{v:.{digits}f}"
    return str(v)


def money(v: float | None) -> str:
    return "-" if v is None else f"{v:.3f}"


def total(rs: list[dict], key: str) -> float | None:
    known = [r[key] for r in rs if r.get(key) is not None]
    return sum(known) if known else None


def rate(rs: list[dict]) -> str:
    hits = [hit(r) for r in rs if hit(r) is not None]
    if hits:
        return f"{sum(hits)} of {len(hits)}"
    return "n/a" if any("code_tool" in r for r in rs) else "-"


def na(r: dict, value: str) -> str:
    """The value, or `n/a` where no code tool is the right move, or `-` on a row from before the column."""
    if "code_tool" not in r:
        return "-"
    return value if r["code_tool"] else "n/a"


def cell_table(rs: list[dict]) -> list[str]:
    out = ["| Agent | Task | Arm | Outcome | Code tool | Hit | Wall s | Turns | In | Out | Cache read | Cache write "
           "| Reasoning | $ | First tool | Code-tool calls | Searches | Reads | After the tool | Tool errors "
           "| Turn cap |",
           "|---|---|---|---|---|---|---:|---:|---:|---:|---:|---:|---:|---:|---|---:|---:|---:|---:|---:|---|"]
    for r in sorted(rs, key=lambda r: (r.get("driver", ""), r.get("task", ""), r.get("arm", ""))):
        right = r.get("code_tool")
        out.append(
            f"| {r.get('driver', 'claude-code')} | {r.get('task')} | {r.get('arm')} | {r.get('outcome')} "
            f"| {na(r, str(right))} | {na(r, fmt(hit(r)))} | {fmt(r.get('wall_s'))} | {fmt(r.get('turns'))} "
            f"| {fmt(r.get('input_tokens'))} | {fmt(r.get('output_tokens'))} | {fmt(r.get('cache_read_tokens'))} "
            f"| {fmt(r.get('cache_write_tokens'))} | {fmt(r.get('reasoning_tokens'))} | {money(usd(r))} "
            f"| {fmt(r.get('first_tool'))} | {na(r, fmt(r.get('code_tool_calls')))} "
            f"| {fmt(r.get('searches'))} | {fmt(r.get('reads'))} | {fmt(r.get('text_after_code_tool'))} "
            f"| {fmt(r.get('tool_errors'))} | {fmt(r.get('turn_cap'))} |")
    return out


def agent_table(rs: list[dict]) -> list[str]:
    out = ["| Agent | Arm | Cells | Green | Tool hit rate | Wall s | Turns | Tokens | $ | Fell back after the tool "
           "| Tool errors | Turn caps |",
           "|---|---|---:|---:|---|---:|---:|---:|---:|---:|---:|---:|"]
    for driver, arm in sorted({(r.get("driver", "claude-code"), r.get("arm")) for r in rs}):
        cs = [r for r in rs if (r.get("driver", "claude-code"), r.get("arm")) == (driver, arm)]
        dollars = [usd(r) for r in cs if usd(r) is not None]
        fell = [r["text_after_code_tool"] > 0 for r in cs if r.get("text_after_code_tool") is not None]
        caps = [r["turn_cap"] for r in cs if r.get("turn_cap") is not None]
        out.append(
            f"| {driver} | {arm} | {len(cs)} | {sum(r.get('outcome') == 'green' for r in cs)} | {rate(cs)} "
            f"| {fmt(total(cs, 'wall_s'))} | {fmt(total(cs, 'turns'))} | {fmt(total(cs, 'tokens'))} "
            f"| {money(sum(dollars) if dollars else None)} | {f'{sum(fell)} of {len(fell)}' if fell else '-'} "
            f"| {fmt(total(cs, 'tool_errors'))} | {sum(caps) if caps else '-'} |")
    return out


def task_table(rs: list[dict]) -> list[str]:
    """Per task and agent, the cell with the code tools beside the no-code-tools one."""
    out = ["| Task | Agent | Code tool | Hit | Green with / without | Wall s with / without "
           "| Tokens with / without | $ with / without |",
           "|---|---|---|---|---|---|---|---|"]
    for task, driver in sorted({(r.get("task"), r.get("driver", "claude-code")) for r in rs}):
        cs = [r for r in rs if (r.get("task"), r.get("driver", "claude-code")) == (task, driver)]
        without = [r for r in cs if r.get("arm") == "jk-nograph"]
        with_ = [r for r in cs if r.get("arm") != "jk-nograph"]

        def side(group: list[dict], f) -> str:
            return ", ".join(f(r) for r in group) or "-"

        right = next((r["code_tool"] for r in with_ if r.get("code_tool")), None)
        out.append(
            f"| {task} | {driver} | {right or rate(with_)} | {rate(with_)} "
            f"| {side(with_, lambda r: fmt(r.get('outcome') == 'green'))} / "
            f"{side(without, lambda r: fmt(r.get('outcome') == 'green'))} "
            f"| {side(with_, lambda r: fmt(r.get('wall_s')))} / {side(without, lambda r: fmt(r.get('wall_s')))} "
            f"| {side(with_, lambda r: fmt(r.get('tokens')))} / {side(without, lambda r: fmt(r.get('tokens')))} "
            f"| {side(with_, lambda r: money(usd(r)))} / {side(without, lambda r: money(usd(r)))} |")
    return out


def tool_table(rs: list[dict]) -> list[str]:
    """Per task, its right code tool and in how many of the cells offering it the agent called it."""
    out = ["| Task | Code tool | Tool hit rate | Agents that did not call it |", "|---|---|---|---|"]
    for task in sorted({r.get("task") for r in rs if r.get("code_tool")}):
        cs = [r for r in rs if r.get("task") == task and r.get("code_tool")]
        missed = sorted({r.get("driver", "claude-code") for r in cs if hit(r) is False})
        out.append(f"| {task} | {cs[0]['code_tool']} | {rate(cs)} | {', '.join(missed) or '-'} |")
    return out


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--since", required=True, help="the night's first date, YYYY-MM-DD")
    ns = ap.parse_args()
    rs = rows(dt.date.fromisoformat(ns.since))
    published = tomllib.loads(cost.PRICES.read_text()).get("published")
    day = published.date().isoformat() if hasattr(published, "date") else str(published)
    print(f"# Bench night from {ns.since}: {len(rs)} cells")
    print()
    if not rs:
        print("No rows yet.")
        return 0
    print(f"Dollars: API list prices of the price table published {day}. Hit: the agent called the right code "
          "tool; n/a where the arm offers none. After the tool: text searches and reads after the first "
          "code-tool call.")
    for title, table in (("Per agent and arm", agent_table), ("Per task and code tool", tool_table),
                         ("Per task and agent, with the code tools / without", task_table),
                         ("Every cell", cell_table)):
        print()
        print(f"## {title}")
        print()
        print("\n".join(table(rs)))
    return 0


if __name__ == "__main__":
    sys.exit(main())
