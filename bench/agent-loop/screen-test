#!/usr/bin/env python3
"""Tier 1: is an agent's prescription reliably graph-first across real tasks? Three tasks on two small
repositories (a caller question and a rename on spring-petclinic, a rename on gs-uploading-files), three
runs each, through change-tasks with smoke-test's arms (the prescriptions tier 0 passed) added.

    bench/agent-loop/screen-test                         # every agent on its prescription
    bench/agent-loop/screen-test --agent cursor --agent muse
    bench/agent-loop/screen-test --runs 1

Rows go to change-tasks' results, numbered from --first-run (default 1200), so a tier-1 screen is its own
series. Arms and the preflight are change-tasks' own.
"""

from __future__ import annotations

import argparse
import importlib.machinery
import importlib.util
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent

# Each agent's prescription, the arm that passed tier 0 for it.
PRESCRIPTIONS = {
    "claude-code": "jk",
    "cursor": "jk-cursorrules",
    "grok": "jk",
    "agy": "jk-agyrules",
    "muse": "jk-musemd",
}
# The AGENTS.md section under test: callers and rename merged into one line that also says "first, with
# T.m as the task names it, before opening or searching a file" (what muse needed), within 1000 bytes.
SECTION_FILE = HERE / "screen" / "agents-section.md"
TASKS = ["petclinic-callers-addpet", "petclinic-rename-addvisit", "gs-uploading-rename-loadasresource"]


def load(name: str, path: Path):
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--agent", action="append", choices=sorted(PRESCRIPTIONS))
    ap.add_argument("--runs", type=int, default=3)
    ap.add_argument("--first-run", type=int, default=1200)
    ap.add_argument("--section", action="store_true",
                    help="each prescription with AGENTS.md written from screen/agents-section.md")
    ns = ap.parse_args()
    # smoke-test adds the tier-0 arms to the change-tasks module it loads; its main is not run.
    ct = load("smoke_test", HERE / "smoke-test").ct
    missing = sorted(set(PRESCRIPTIONS.values()) - set(ct.ARMS))
    if missing:
        raise SystemExit(f"screen-test: no arm {', '.join(missing)} in change-tasks or smoke-test; "
                         "a prescription moved or was renamed")
    arms = dict(PRESCRIPTIONS)
    if ns.section:
        agents_md = (f"# AGENTS.md\n\n<!-- BEGIN:jumpkick -->\n{SECTION_FILE.read_text()}"
                     "<!-- END:jumpkick -->\n")
        # muse's prescription was its AGENTS.md line, which the section now carries: plain jk with it.
        for agent, arm in PRESCRIPTIONS.items():
            base = dict(ct.ARMS["jk" if arm == "jk-musemd" else arm])
            base.pop("agents_line", None)
            base["files"] = {**base.get("files", {}), "AGENTS.md": agents_md}
            ct.ARMS[arm + "+section"] = base
            arms[agent] = arm + "+section"
    status = 0
    for agent in ns.agent or list(PRESCRIPTIONS):
        argv = ["change-tasks", "--driver", agent, "--arm", arms[agent], "--runs", str(ns.runs),
                "--first-run", str(ns.first_run)]
        for task in TASKS:
            argv += ["--task", task]
        print(f"== {agent} ({arms[agent]})", flush=True)
        sys.argv = argv
        status |= ct.main() or 0
    return status


if __name__ == "__main__":
    sys.exit(main())
