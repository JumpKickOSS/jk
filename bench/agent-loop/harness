#!/usr/bin/env python3
"""Drive an agent over the agent-loop corpus and record turns, tokens and wall to green.

    harness --dry-run                                   # the (scenario × tool) matrix
    harness --driver scripted                           # the deterministic oracle over the whole matrix
    harness --driver claude-code --only gs-rest-service:missing-dependency
    harness --driver api --only gs-rest-service:compile-error --tool jk
    harness --driver grok --only gs-rest-service:compile-error
    harness --render

For each (repo × failure × tool) the harness materialises the sandbox with `scenario`, runs the
tool once so the results file is red, starts the tool's MCP server (jk: the shared engine's,
bound to the sandbox; Maven and Gradle: `wrappers/results-mcp`) and hands the agent a fixed
system prompt: the build is red, make it green, use only these tools, stop when the results say
OK. The agent runs until green or the budget (`--max-turns` 16, `--max-minutes` 10) is spent; the
harness then reruns the tool itself and calls the row green only when that rerun is green too.
A Gradle run stops that Gradle's daemons after the rerun. `--render` recomputes signal metrics
from transcripts and sandboxes already on disk and rewrites the table; it does not run an agent.

Drivers: `scripted` (an oracle that reads the results file and applies the class's known fix;
costs nothing and proves the plumbing), `claude-code` (`claude -p` with the MCP server and file
tools), `grok` (`grok -p` the same way; file tools only, throwaway `GROK_HOME`), `api` (a
Messages-API tool-use loop; needs ANTHROPIC_API_KEY and the anthropic SDK).

Rows go to `results/<date>/rows.jsonl` beside this script and the table to `TABLE.md` there;
sandboxes and transcripts live under `$AGENT_LOOP_HOME/harness/<date>/` (default
`$JK_BENCH_HOME/agent-loop`; `$JK_BENCH_HOME` defaults to `${XDG_CACHE_HOME:-~/.cache}/jk-bench`),
never in this tree.
"""

from __future__ import annotations

import argparse
import concurrent.futures
import datetime as dt
import importlib.machinery
import importlib.util
import json
import os
import shutil
import sys
import time
import traceback
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
sys.path.insert(0, str(HERE.parent))
import benchtools  # noqa: E402

from harnesslib import agents, metrics, oracle, report  # noqa: E402
from harnesslib.session import Session, open_mcp, results_ok  # noqa: E402

HOME = benchtools.scratch("AGENT_LOOP_HOME", "agent-loop")
DRIVERS = ("scripted", "claude-code", "api", "grok")
DEFAULT_MODEL = "claude-sonnet-5"
DEFAULT_GROK_MODEL = "grok-4.7"
DEFAULT_EFFORT = "high"
# Real runs stop Gradle on the way out. --help, --dry-run, and --render do not.
_stop_gradle_on_exit = True


def resolve_model(driver: str, model: str | None) -> str | None:
    if driver == "scripted":
        return None
    if model:
        return model
    return DEFAULT_GROK_MODEL if driver == "grok" else DEFAULT_MODEL


def load_scenario_module():
    loader = importlib.machinery.SourceFileLoader("scenario", str(HERE / "scenario"))
    spec = importlib.util.spec_from_loader("scenario", loader)
    module = importlib.util.module_from_spec(spec)
    sys.modules["scenario"] = module  # dataclasses resolve their annotations through sys.modules
    loader.exec_module(module)
    return module


scenario = load_scenario_module()


# ------------------------------------------------------------------------------ matrix


def matrix(repos: dict, tools: list[str], only: str | None) -> list[tuple]:
    want = None
    if only:
        repo_name, _, failure = only.partition(":")
        if repo_name not in repos:
            sys.exit(f"unknown repo {repo_name}; known: {', '.join(repos)}")
        want = (repo_name, failure or None)
    work = []
    for repo in repos.values():
        if want and repo.name != want[0]:
            continue
        for failure in repo.failures:
            if want and want[1] and failure != want[1]:
                continue
            for tool in scenario.TOOLS:
                if tool in tools and tool in repo.tools and tool in repo.failures[failure].get("tools", repo.tools):
                    work.append((repo, failure, tool))
    return work


# --------------------------------------------------------------------------------- run


def run_one(repo, failure: str, tool: str, ns, run_root: Path) -> dict:
    name = f"{repo.name}.{failure}"
    run_dir = run_root / tool / name
    if run_dir.exists():
        shutil.rmtree(run_dir)
    run_dir.mkdir(parents=True)
    sandbox = run_dir / "sandbox"
    transcript = run_dir / "transcript.jsonl"
    row = {
        "date": ns.date, "driver": ns.driver, "model": ns.model if ns.driver != "scripted" else None,
        "tool": tool, "repo": repo.name, "failure": failure,
        "max_turns": ns.max_turns, "max_minutes": ns.max_minutes,
        "outcome": "error", "turns": 0, "tokens": 0, "input_tokens": 0, "output_tokens": 0,
        "cache_read_tokens": 0, "cache_write_tokens": 0, "cost_usd": 0.0,
        "wall_ms": 0, "red_wall_ms": 0, "verify_wall_ms": 0,
        "claims_green": False, "verified_green": False, "fix_sources": [], "finding": "",
        "first_edit_turn": None, "first_correct_edit_turn": None,
        "edits": 0, "wrong_edits": 0, "reads_before_fix": 0, "fix_quality": None,
        "sandbox": str(sandbox), "transcript": str(transcript),
    }
    if ns.driver != "scripted":
        row["reasoning_tokens"] = 0
    if ns.driver == "grok":
        row["effort"] = ns.effort
    row.update(benchtools.stamp(ns.tools))
    try:
        scenario.materialise(repo, tool, failure, sandbox)
        code, out, red_wall = scenario.run_tool(sandbox, tool)
        row["red_wall_ms"] = red_wall
        (run_dir / "red.log").write_text(scenario.strip_ansi(out), encoding="utf-8")
        _note_tool(row, sandbox, tool, out)
        if code == 0:
            row.update(outcome="error", finding="the injection did not break the build (exit 0 before the agent started)")
            return row
        # The red run already started Gradle's daemon. The agent's builds, and the rerun below, keep it.
        if tool == "gradle":
            row["gradle_daemon"] = "warm"
        started = time.monotonic()
        deadline = started + ns.max_minutes * 60
        if ns.driver == "scripted":
            session = Session(tool, sandbox, open_mcp(tool, sandbox))
            try:
                res = oracle.scripted(session, repo.failures[failure], ns.max_turns, deadline, time.monotonic)
            finally:
                session.close()
            transcript.write_text("".join(json.dumps(e, ensure_ascii=False) + "\n" for e in res.transcript), encoding="utf-8")
            row.update(turns=res.turns, fix_sources=res.fix_sources, finding=res.finding, claims_green=res.green)
        else:
            run = {"claude-code": agents.claude_code, "api": agents.api, "grok": agents.grok}[ns.driver]
            kwargs = {"effort": ns.effort} if ns.driver == "grok" else {}
            res = run(tool, sandbox, ns.model, ns.max_turns, ns.max_minutes * 60, transcript, **kwargs)
            usage = res.usage
            row.update(
                turns=res.turns, finding=res.finding,
                cost_usd=None if res.cost_usd is None else round(res.cost_usd, 4),
                input_tokens=usage.get("input_tokens", 0), output_tokens=int(usage.get("output_tokens") or 0),
                cache_read_tokens=usage.get("cache_read_input_tokens", 0), cache_write_tokens=usage.get("cache_creation_input_tokens", 0),
                reasoning_tokens=agents.reasoning_count(usage, res.extra.get("model_usage")),
                claims_green=res.green_claimed or agents.claims_green_from_results(sandbox),
            )
            if res.extra.get("tools"):
                row["tools"] = res.extra["tools"]
            row["tokens"] = row["input_tokens"] + row["output_tokens"] + row["cache_read_tokens"] + row["cache_write_tokens"]
            (run_dir / "agent.json").write_text(json.dumps({"summary": res.transcript, "extra": res.extra}, indent=1, ensure_ascii=False), encoding="utf-8")
        row["wall_ms"] = int((time.monotonic() - started) * 1000)
        # The harness's own rerun decides: an agent's claim, or a results file from a partial run, is not green.
        code, out, verify_wall = scenario.run_tool(sandbox, tool)
        (run_dir / "verify.log").write_text(scenario.strip_ansi(out), encoding="utf-8")
        _note_tool(row, sandbox, tool, out)
        row["verify_wall_ms"] = verify_wall
        row["verified_green"] = code == 0
        if row["claims_green"] and row["verified_green"]:
            row["outcome"] = "green"
        elif row["claims_green"]:
            row["outcome"] = "claimed"
            row["finding"] = (row["finding"] + "; " if row["finding"] else "") + f"the agent reported green but the harness rerun exits {code}"
        else:
            row["outcome"] = "red"
            if row["verified_green"]:
                row["finding"] = (row["finding"] + "; " if row["finding"] else "") + "the tree is green although the agent did not report it"
    except Exception as e:
        row["outcome"] = "error"
        message = str(e).splitlines()[0] if str(e) else ""
        row["finding"] = f"{type(e).__name__}: {message}"[:300]
        if "incompatible-with-latest-gradle" in message:
            row["status"] = "incompatible-with-latest-gradle"
            row["error"] = message.split("incompatible-with-latest-gradle:", 1)[-1].strip()
        (run_dir / "error.log").write_text(traceback.format_exc(), encoding="utf-8")
    finally:
        metrics.enrich(row, repo.failures.get(failure, {}))
    return row


def run_guarded(repo, failure: str, tool: str, ns, run_root: Path) -> dict:
    """Gradle scenarios take the install-wide daemon lock and stop the daemon after the rerun."""
    if tool != "gradle":
        return run_one(repo, failure, tool, ns, run_root)
    with benchtools.gradle_run():
        return run_one(repo, failure, tool, ns, run_root)


def _note_tool(row: dict, sandbox: Path, tool: str, out: str) -> None:
    meta_path = sandbox / "target" / "jk-bench.json"
    if meta_path.is_file():
        meta = json.loads(meta_path.read_text(encoding="utf-8"))
        for key in ("java_home", "java_version", "jdk", "env_stripped", "status", "error"):
            if key in meta and key not in row:
                row[key] = meta[key]
    if tool == "gradle":
        rejected = benchtools.gradle_incompatibility(scenario.strip_ansi(out))
        if rejected:
            row["status"] = "incompatible-with-latest-gradle"
            row["error"] = rejected


def print_row(row: dict) -> None:
    mark = {"green": "ok  ", "red": "RED ", "claimed": "CLM ", "error": "ERR "}[row["outcome"]]
    tokens = f"{row['tokens']:>8,}" if row["tokens"] else "        "
    correct = row.get("first_correct_edit_turn")
    correct_s = "·" if correct is None else str(correct)
    quality = row.get("fix_quality") or "·"
    print(f"{mark} {row['repo']:28} {row['failure']:20} {row['tool']:6} {row['turns']:>2}t {row['wall_ms'] / 1000:6.1f}s {tokens}  "
          f"fix@{correct_s} {quality}  "
          f"{', '.join(row['fix_sources']) or ''}{'  ' + row['finding'] if row['finding'] else ''}", flush=True)


# -------------------------------------------------------------------------------- main


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n", 1)[0], formatter_class=argparse.RawDescriptionHelpFormatter, epilog=__doc__.split("\n\n", 1)[1])
    ap.add_argument("--driver", choices=DRIVERS, default="scripted")
    ap.add_argument("--model", default=None,
                    help=f"model for the LLM drivers (default {DEFAULT_MODEL}; {DEFAULT_GROK_MODEL} for --driver grok)")
    ap.add_argument("--effort", default=DEFAULT_EFFORT,
                    help=f"reasoning effort for --driver grok, passed as --reasoning-effort (default {DEFAULT_EFFORT})")
    ap.add_argument("--tool", choices=scenario.TOOLS, action="append", help="restrict to a tool (repeatable; default all three)")
    ap.add_argument("--only", metavar="REPO[:FAILURE]", help="one repo, or one repo × failure")
    ap.add_argument("--max-turns", type=int, default=16, help="turn budget per run (default 16)")
    ap.add_argument("--max-minutes", type=float, default=10, help="wall budget per run in minutes (default 10)")
    ap.add_argument("--jobs", type=int, default=2, help="runs in parallel (default 2)")
    ap.add_argument("--date", default=dt.date.today().isoformat(), help="results directory name (default today)")
    ap.add_argument("--results", type=Path, help="results directory (default results/<date> beside this script)")
    ap.add_argument("--dry-run", action="store_true", help="list the matrix and exit")
    ap.add_argument("--render", action="store_true",
                    help="recompute signal metrics from rows already in --results (or results/<date>) and rewrite the table; do not run agents")
    benchtools.add_arguments(ap)
    ns = ap.parse_args()
    global _stop_gradle_on_exit
    if ns.render or ns.dry_run:
        _stop_gradle_on_exit = False
    if ns.render:
        return render_existing(ns)
    ns.model = resolve_model(ns.driver, ns.model)
    benchtools.use_flags(ns)
    repos = scenario.load_config()
    tools = ns.tool or list(scenario.TOOLS)
    work = matrix(repos, tools, ns.only)
    if ns.dry_run:
        for repo, failure, tool in work:
            print(f"{repo.name:28} {failure:20} {tool}")
        detail = ""
        if ns.driver != "scripted":
            detail += f" · {ns.model}"
        if ns.driver == "grok":
            detail += f" · effort {ns.effort}"
        print(f"\n{len({(r.name, f) for r, f, _ in work})} scenarios · {len(work)} (scenario × tool) runs · driver {ns.driver}"
              + detail + f" · budget {ns.max_turns} turns / {ns.max_minutes:g} min")
        return 0
    if not work:
        sys.exit("nothing to run")
    ns.tools = benchtools.resolve(allow_stale=ns.allow_stale_tools, offline=ns.offline_tools)
    if ns.driver == "api" and not os.environ.get("ANTHROPIC_API_KEY"):
        sys.exit("the api driver needs ANTHROPIC_API_KEY")
    results_dir = ns.results or HERE / "results" / ns.date
    run_root = HOME / "harness" / ns.date / ns.driver
    run_root.mkdir(parents=True, exist_ok=True)
    rows: list[dict] = []
    started = time.time()
    jobs = 1 if ns.driver != "scripted" else ns.jobs
    with concurrent.futures.ThreadPoolExecutor(max_workers=jobs) as pool:
        futures = [pool.submit(run_guarded, repo, failure, tool, ns, run_root) for repo, failure, tool in work]
        for fut in concurrent.futures.as_completed(futures):
            row = fut.result()
            rows.append(row)
            print_row(row)
    rows_path = results_dir / "rows.jsonl"
    merged = report.merge(report.load_rows(rows_path), rows)
    refresh_metrics(merged)
    report.write_rows(rows_path, merged)
    table = report.render(merged, scenario.jk_version())
    (results_dir / "TABLE.md").write_text(table, encoding="utf-8")
    elapsed = int(time.time() - started)
    green = sum(1 for r in rows if r["outcome"] == "green")
    print(f"\n{green} / {len(rows)} green in {elapsed // 60}m {elapsed % 60}s · wrote {rows_path} and {results_dir / 'TABLE.md'}")
    return 0 if green == len(rows) else 1


def refresh_metrics(rows: list[dict]) -> None:
    """Recompute signal quality for every row that still has its transcript and sandbox."""
    repos = scenario.load_config()
    for row in rows:
        repo = repos.get(row.get("repo"))
        spec = repo.failures.get(row.get("failure"), {}) if repo else {}
        metrics.enrich(row, spec)


def render_existing(ns) -> int:
    results_dir = ns.results or HERE / "results" / ns.date
    rows_path = results_dir / "rows.jsonl"
    rows = report.load_rows(rows_path)
    if not rows:
        sys.exit(f"no rows in {rows_path}")
    refresh_metrics(rows)
    report.write_rows(rows_path, rows)
    table = report.render(rows, scenario.jk_version())
    (results_dir / "TABLE.md").write_text(table, encoding="utf-8")
    print(table)
    print(f"\nwrote {rows_path} and {results_dir / 'TABLE.md'}")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    finally:
        if _stop_gradle_on_exit and "--help" not in sys.argv and "-h" not in sys.argv:
            benchtools.stop_gradle()
