<?xml version="1.0" encoding="UTF-8"?>
<!-- Hand-written stand-in for a third party's starter parent; never produced by jk's own writer. -->
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.demo</groupId>
    <artifactId>demo-dependencies</artifactId>
    <version>1.0</version>
  </parent>
  <artifactId>demo-starter-parent</artifactId>
  <packaging>pom</packaging>
  <properties>
    <resource.delimiter>@</resource.delimiter>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
  </dependencies>
  <profiles>
    <profile>
      <id>native</id>
      <properties>
        <native.build>true</native.build>
      </properties>
    </profile>
  </profiles>
</project>
