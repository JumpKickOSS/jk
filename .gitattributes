# LF in the object store and the working tree, on every OS.
# Overrides Git for Windows' installer default (core.autocrlf=true).
* text=auto eol=lf

# cmd.exe still treats LF-only batch files as one line.
*.bat text eol=crlf
*.cmd text eol=crlf

*.jar binary
*.png binary
*.webp binary

# Marketing media lives in Git LFS: the demo videos, their posters, and the README banner. The
# small brand files (jk-logo.svg, jumpkick-logo.webp) stay plain: the web UI bundles them.
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.webm filter=lfs diff=lfs merge=lfs -text
docs/assets/**/*.png filter=lfs diff=lfs merge=lfs -text
hosting/public/*demo*.webp filter=lfs diff=lfs merge=lfs -text
